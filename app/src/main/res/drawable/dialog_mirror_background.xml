<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/_20sdp"
                android:topRightRadius="@dimen/_20sdp"
                android:bottomLeftRadius="@dimen/_20sdp"
                android:bottomRightRadius="@dimen/_20sdp"/>
            <solid android:color="@color/white_75" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_25sdp" />
            <gradient
                android:startColor="#80FFFFFF"
                android:centerColor="#80FFFFFF"
                android:endColor="#80FFFFFF"
                android:gradientRadius="50dp"
                android:type="radial" />
        </shape>
    </item>

</layer-list>