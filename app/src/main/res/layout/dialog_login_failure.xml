<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="@dimen/_15sdp"
    card_view:cardCornerRadius="@dimen/_20sdp"
    android:elevation="@dimen/_4sdp"
    android:backgroundTint="@color/white_95">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginVertical="@dimen/_35sdp"
        android:paddingVertical="@dimen/_10sdp">


        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/tv_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/dialog_style"
           />



    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
        android:id="@+id/btnCloseDialog"
        android:text="@string/close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/yello_rectangle_shape"
        style="@style/dialog_button_text_style"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_5sdp"
        android:elevation="@dimen/_4sdp"
        android:layout_marginHorizontal="@dimen/_30sdp"
        android:layout_marginVertical="@dimen/_8sdp"
        android:paddingHorizontal="@dimen/_30sdp"
        android:layout_gravity="center"
        />

    </LinearLayout>


</androidx.cardview.widget.CardView>