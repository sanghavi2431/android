<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/application_background"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_created_at"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_regular"
            android:textStyle="bold"
            android:paddingTop="@dimen/margin_4"
            android:paddingLeft="@dimen/margin_10"
            android:paddingRight="@dimen/margin_10"
            android:textSize="@dimen/size_7"
            android:textColor="#ffffff"
            android:text="January 2021" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingRight="@dimen/margin_5"
            android:paddingLeft="@dimen/margin_5"
            android:paddingTop="@dimen/margin_3"
            android:paddingBottom="@dimen/margin_3"
            android:layout_marginTop="@dimen/margin_4"
            android:background="@color/black"
            android:orientation="horizontal">

            <in.woloo.www.utils.CircleImageView
                android:id="@+id/ivWolooStore"
                android:layout_width="@dimen/margin_25"
                android:layout_height="@dimen/margin_25"
                android:layout_gravity="center" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCreditMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_regular"
                    android:textStyle="bold"
                    android:textSize="@dimen/size_6"
                    android:textAlignment="textStart"
                    android:textColor="#ffffff"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:layout_margin="@dimen/margin_3"
                    android:lineSpacingExtra="5.3sp"
                    android:includeFontPadding="false"
                    android:text="" />



                <TextView
                    android:id="@+id/tv_remarks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_regular"
                    android:textSize="@dimen/size_4"
                    android:textColor="#ffffff"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:layout_margin="@dimen/margin_3"
                    android:lineSpacingExtra="5.3sp"
                    android:text="" />

                <TextView
                    android:id="@+id/tv_updated_at"
                    android:layout_gravity="start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_regular"
                    android:textStyle="normal"
                    android:textSize="@dimen/size_5"
                    android:layout_marginLeft="@dimen/margin_3"
                    android:textColor="#ffffff"
                    android:lineSpacingExtra="13sp"
                    android:gravity="center"
                    android:text="09 January" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPoints"
                    android:layout_width="@dimen/margin_25"
                    android:layout_height="@dimen/margin_25"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/margin_5"
                    android:text=""
                    android:textColor="@color/text_color_five"
                    android:background="@drawable/ic_points"/>



            </LinearLayout>



        </LinearLayout>



    </LinearLayout>

</RelativeLayout>