<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    app:cardCornerRadius="@dimen/_48sdp"
    android:layout_margin="@dimen/_15sdp"
    android:elevation="@dimen/_4sdp"
    android:background="@color/white_75">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/_20sdp">

    <LinearLayout
        android:id="@+id/ivBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:gravity="center"
        android:visibility="gone"
        android:paddingTop="@dimen/_10sdp">

        <ImageView

            android:layout_width="@dimen/_10sdp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_7sdp"
            android:adjustViewBounds="true"
            android:rotation="90"
            android:layout_gravity="center"
            android:src="@drawable/down_arrow_bottom_bar"
            />
        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/small_gray_style"
            android:text="@string/back"
            android:gravity="center"
            />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/screen_header"
            style="@style/screen_header_text_style_big_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your periods \nlike a pro!"  />


        <View
           android:background="@color/start_theme_color"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_2sdp"
           android:layout_gravity="center"
            android:layout_marginTop="@dimen/_5sdp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
           >

            <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/mention_your_period_date"
                style="@style/ten_black_center"
                android:layout_marginTop="@dimen/_5sdp"
               />

            <LinearLayout
                android:id="@+id/date_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_10"
                android:layout_marginTop="@dimen/margin_5"
                android:layout_marginEnd="@dimen/margin_10"
                android:layout_marginBottom="@dimen/margin_5"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:id="@+id/day_Tv"
                    android:layout_width="@dimen/_57sdp"
                    android:layout_height="@dimen/_57sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/grey_text_bg_small"
                    android:gravity="center"
                    android:inputType="phone"
                    android:digits="0123456789"
                    android:elevation="@dimen/_1sdp"
                    style="@style/screen_header_text_style_big_center_nomargin"
                    />

                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:id="@+id/month_Tv"
                    android:layout_width="@dimen/_57sdp"
                    android:layout_height="@dimen/_57sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/grey_text_bg_small"
                    android:gravity="center"
                    android:inputType="phone"
                    android:digits="0123456789"
                    android:elevation="@dimen/_1sdp"
                    style="@style/screen_header_text_style_big_center_nomargin"
                    />

                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:id="@+id/year_TV"
                    android:layout_width="@dimen/_57sdp"
                    android:layout_height="@dimen/_57sdp"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/grey_text_bg_small"
                    android:gravity="center"
                    android:elevation="@dimen/_1sdp"
                    android:inputType="phone"
                    android:digits="0123456789"
                    style="@style/screen_header_text_style_big_center_nomargin"
                    />

            </LinearLayout>

            <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_5"
                android:gravity="center"
                android:text="@string/your_cycle_length_in_days"
               style="@style/ten_black_center" />

            <in.woloo.www.application_kotlin.utilities.CenturiGothicBoldEditText
                android:id="@+id/cycle_length_edText"
                android:layout_width="@dimen/_57sdp"
                android:layout_height="@dimen/_57sdp"
                android:layout_margin="@dimen/_5sdp"
                android:background="@drawable/grey_text_bg_small"
                android:gravity="center"
                android:elevation="@dimen/_1sdp"
                android:layout_gravity="center_horizontal"
                android:inputType="phone"
                android:digits="0123456789"
                style="@style/screen_header_text_style_big_center_nomargin"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/margin_4"
                    android:layout_height="@dimen/margin_4"
                    android:src="@drawable/ic_info"
                    app:tint="#F09334"
                    android:visibility="gone"/>

                <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_2"
                    android:gravity="center"
                    android:visibility="gone"
                    android:text="Days between the last month cycle and current cycle"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/size_5" />
            </LinearLayout>

            <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_7"
                android:gravity="center"
                android:text="@string/your_period_length_in_days"
                style="@style/ten_black_center"
                 />

            <in.woloo.www.application_kotlin.utilities.CenturiGothicBoldEditText
                android:id="@+id/period_length_edText"
                android:layout_width="@dimen/_57sdp"
                android:layout_height="@dimen/_57sdp"
                android:layout_margin="@dimen/_5sdp"
                android:background="@drawable/grey_text_bg_small"
                android:gravity="center"
                android:elevation="@dimen/_1sdp"
                android:layout_gravity="center_horizontal"
                android:inputType="phone"
                android:digits="0123456789"
                style="@style/screen_header_text_style_big_center_nomargin"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/margin_4"
                    android:layout_height="@dimen/margin_4"
                    android:src="@drawable/ic_info"
                    app:tint="#F09334" />

                <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_2"
                    android:gravity="center"
                    android:text="Please mention the good bleeding days"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/size_5" />
            </LinearLayout>

            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:id="@+id/save_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/_20sdp"
                android:paddingHorizontal="@dimen/_50sdp"
                android:background="@drawable/yello_rectangle_shape"
                android:gravity="center"
                android:layout_gravity="center"
                android:text="@string/save"
              style="@style/button_text_style"/>

            <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_10"
                android:visibility="gone"
                android:text="@string/edit_cycle_note" />

        </LinearLayout>


    </ScrollView>
    </LinearLayout>

</androidx.cardview.widget.CardView>