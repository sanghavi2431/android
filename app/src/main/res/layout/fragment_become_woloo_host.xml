<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/application_background"
    android:orientation="vertical"
    android:paddingBottom="@dimen/margin_27"
    tools:context=".woloo_host.BecomeWolooHostFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="@dimen/margin_12"
        android:layout_height="@dimen/margin_20"
        android:alpha="0.8"
        android:src="@drawable/ic_left_arrow" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_color"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_weight="1"
        android:gravity="center"
        tools:text="Maximum length of the title upto this size title upto this size" />

        <TextView
            android:id="@+id/tv_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/skip"
            android:textColor="@color/text_color"
            android:textSize="13sp"
            android:layout_gravity="center"
            android:layout_margin="@dimen/margin_2"
            android:padding="5dp"/>


    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/VP_viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/intrested_Btn" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tutorial_slider_tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            app:tabBackground="@drawable/tab_selector_tutorial_slider"
            app:tabGravity="center"
            app:tabPadding="@dimen/size_1"
            app:tabIndicatorHeight="0dp" />

        <Button
            android:id="@+id/intrested_Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/tutorial_slider_tab"
            android:backgroundTint="@color/text_color"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/black"
            android:layout_centerHorizontal="true"
            android:text="@string/yes_i_am_intrested"/>

    </RelativeLayout>

</LinearLayout>