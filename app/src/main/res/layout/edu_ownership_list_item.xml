<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/new_button_background_square"
    android:elevation="@dimen/_4sdp"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_margin="@dimen/_10sdp"
    android:id="@+id/card_view_edu"
    android:padding="@dimen/_5sdp"
    >



    <ImageView
        android:id="@+id/checkboxItem"
        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic__01_hormones"
        android:layout_marginTop="@dimen/_9sdp"/>




    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
        android:id="@+id/itemNameText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:text=""
        android:maxLines="4"
        android:lines="4"
        android:gravity="center"
        style="@style/ten_black_center"
        android:textColor="@color/black"
        android:layout_margin="@dimen/_5sdp"/>

</LinearLayout>