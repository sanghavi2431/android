    <ImageView
        android:id="@+id/close_dialog_sos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:visibility="gone"
        android:src="@drawable/yellow_close"/>

    <ScrollView
