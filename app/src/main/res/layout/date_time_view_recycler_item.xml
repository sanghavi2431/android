<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:elevation="@dimen/_4sdp"
    android:layout_margin="@dimen/_5sdp"
    android:background="@drawable/new_button_background"
    android:padding="@dimen/_10sdp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_horizontal"
    android:layout_marginVertical="@dimen/_3sdp">
    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mon"
        android:gravity="center"
        style="@style/twelve_black_nomargin_center"
        android:id="@+id/select_service_day"
        android:layout_marginHorizontal="@dimen/_3sdp"
        />

    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25"
        android:gravity="center"
        style="@style/twelve_black_nomargin_center"
        android:id="@+id/select_service_date"
        android:layout_marginHorizontal="@dimen/_3sdp"
        />
</LinearLayout>
    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="10.00 AM - 11.00 PM"
        android:layout_gravity="center"
        style="@style/ten_black_center"
        android:id="@+id/select_service_time"
        android:layout_marginTop="@dimen/_3sdp"
        />

</LinearLayout>