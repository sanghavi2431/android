<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_background"
    android:orientation="vertical">

<LinearLayout
    android:layout_width="@dimen/margin_130"
    android:layout_height="wrap_content"
    android:padding="@dimen/margin_10"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:layout_centerInParent="true"
 >

    <TextView
        android:text="@string/thank_you_for_share_review"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/size_5"
        android:layout_marginTop="@dimen/size_10"
        android:layout_marginBottom="@dimen/size_10"
        android:textSize="@dimen/size_8"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/app_background"
        android:layout_gravity="center" />


    <TextView
        android:id="@+id/tv_dialogreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="normal"
        android:textSize="@dimen/size_6"
        android:textColor="@color/seperator_line_color"
        android:lineSpacingExtra="11.3sp"
        android:gravity="center_horizontal"
        android:text="By sharing your feedback\nyou’re helping other User\nlike you with a hygienic washroom\nexperience." />


    <TextView
        android:id="@+id/tvOK"
        android:text="@string/okay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/size_5"
        android:paddingBottom="@dimen/size_5"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginRight="@dimen/margin_10"
        android:gravity="center"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/size_10"
        android:layout_gravity="center"
        android:textAllCaps="true"
        android:background="@drawable/yellow_rectangle_shape"/>

</LinearLayout>
</RelativeLayout>
