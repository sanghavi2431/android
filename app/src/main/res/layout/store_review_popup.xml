<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:cardview="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/top_corner_dialog_bg"
    app:behavior_peekHeight="@dimen/_400sdp"
    app:layout_behavior="@string/bottom_sheet_behavior"
    android:elevation="@dimen/_4sdp"
    android:layout_marginTop="@dimen/_5sdp"
    android:paddingEnd="@dimen/_5sdp"
    >

    <View
        android:id="@+id/back_dialog"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_3sdp"
        android:background="@color/chip_color"
        android:padding="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_gravity="center_horizontal"/>


    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/cart_header_icon"
        android:text="Write your review"
        style="@style/screen_header_text_style_big_left"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_35sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:id="@+id/cart_header_text"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_9sdp"
        app:cardElevation="@dimen/_4sdp"
        android:backgroundTint="@color/white"
        android:layout_marginLeft="@dimen/_15sdp"
        android:layout_marginRight="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_10sdp">

            <ImageView
                android:id="@+id/ivVeryBad"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="@dimen/margin_5"
                android:src="@drawable/filled_star_new"
                />

            <ImageView
                android:id="@+id/ivBad"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="@dimen/margin_5"
                android:src="@drawable/filled_star_new"/>

            <ImageView
                android:id="@+id/ivAverage"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="@dimen/margin_5"
                android:src="@drawable/filled_star_new"/>

            <ImageView
                android:id="@+id/ivGood"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="@dimen/margin_5"
                android:src="@drawable/empty_star_new"/>

            <ImageView
                android:id="@+id/ivLovedIt"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="@dimen/margin_5"
                android:src="@drawable/empty_star_new"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


        <LinearLayout
            android:id="@+id/text_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:elevation="@dimen/_4sdp"
            android:background="@drawable/new_button_background_square"
            android:layout_margin="@dimen/_15sdp"
            android:paddingVertical="@dimen/_10sdp">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                >
                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    style="@style/refer_3_host_style"
                    android:maxLines="1"
                    android:layout_marginLeft="@dimen/_10sdp"/>

                <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="10"
                    android:lines="10"
                    android:background="@color/transparent"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:hint="Type your review here"
                    style="@style/review_twelve_left"
                    android:id="@+id/review_text"/>


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginVertical="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_8sdp">

                <ImageView
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/payment_edit"
                    android:layout_gravity="top|right"
                    />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>


            </LinearLayout>


        </LinearLayout>







    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_10sdp">
        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/submit_help_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/yello_rectangle_shape"
            android:text="Submit"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:layout_marginVertical="@dimen/_10sdp"
            android:elevation="@dimen/_4sdp"
            style="@style/screen_header_text_style_big_center_nomargin"
            android:paddingVertical="@dimen/_5sdp"/>


    </LinearLayout>

</LinearLayout>