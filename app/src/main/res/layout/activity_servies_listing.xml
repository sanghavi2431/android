<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".services.screens.ServicesProductsListingActivity">

    <LinearLayout
        android:layout_gravity="top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="@dimen/_1sdp"
        android:id="@+id/header_view"
        android:background="@drawable/header_layout_shop_background">
        <LinearLayout
            android:id="@+id/address_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentTop="true"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:layout_marginTop="@dimen/_11sdp"
            android:layout_marginBottom="@dimen/_5sdp">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:id="@+id/home_text"
                    style="@style/refer_3_host_style"
                    android:layout_width="336dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/_3sdp"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_below="@+id/home_text">
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:id="@+id/address_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/nine_left_chip"
                        android:paddingStart="@dimen/_3sdp"
                        android:layout_gravity="center_vertical"
                        android:maxLines="1"
                        android:maxLength="40"
                        />
                    <ImageView
                        android:id="@+id/show_all_address"
                        android:layout_width="@dimen/_13sdp"
                        android:layout_height="@dimen/_13sdp"
                        android:src="@drawable/down_navigate_arrow"
                        android:layout_toEndOf="@+id/address_text"
                        android:layout_margin="@dimen/_5sdp"
                        android:layout_gravity="center_vertical"
                        />
                </LinearLayout>
            </RelativeLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/go_to_cart_view">
                <View
                    android:layout_width="@dimen/_31sdp"
                    android:layout_height="@dimen/_31sdp"
                    android:background="@drawable/imagecircle"
                    android:backgroundTint="@color/search_background"
                    android:layout_gravity="center"/>
                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/shop_icon_bottom_nav"
                    android:layout_gravity="center"/>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|right"
                    >
                    <View
                        android:layout_width="@dimen/_13sdp"
                        android:layout_height="@dimen/_13sdp"
                        android:background="@drawable/imagecircle"
                        android:backgroundTint="@color/start_theme_color"
                        android:layout_gravity="center"
                        />
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="0"
                        android:layout_gravity="center"
                        style="@style/time_nomargin"
                        android:id="@+id/display_cart_count"/>

                </FrameLayout>

            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_below="@+id/address_layout">
            <LinearLayout
                android:id="@+id/search_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/new_button_background"
                android:elevation="@dimen/_4sdp"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                android:layout_weight="1"
                >
                <ImageView
                    android:id="@+id/search_image"
                    android:layout_width="@dimen/_23sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/search_icon_home"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginVertical="@dimen/_7sdp"
                    />
                <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                    android:id="@+id/search_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Search Products"
                    style="@style/twelve_chip_left"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:background="@color/transparent"/>
            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginVertical="@dimen/_5sdp"
                app:cardCornerRadius="@dimen/_20sdp"
                app:cardElevation="@dimen/_4sdp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@android:color/white">
                <ImageView
                    android:id="@+id/filter_products"
                    android:layout_width="@dimen/_31sdp"
                    android:layout_height="@dimen/_31sdp"
                    android:src="@drawable/filter_image"
                    android:padding="@dimen/_5sdp"
                    />
            </androidx.cardview.widget.CardView>


        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_180sdp"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:elevation="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_5sdp">

        <androidx.media3.ui.PlayerView
            android:id="@+id/product_video"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_180sdp"
            android:clipToOutline="true"
            android:scaleType="fitXY"
            app:use_controller="true"
            app:resize_mode="fill"
            tools:ignore="MissingClass"
            />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="All Services"
            style="@style/pop_up_left"
            android:layout_margin="@dimen/_10sdp"
            android:layout_weight="1"/>

        <LinearLayout
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:rotation="90"
                android:layout_gravity="center"
                android:src="@drawable/down_arrow_bottom_bar"
                />
            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                style="@style/small_gray_style"
                android:text="@string/back"
                android:gravity="center"
                android:layout_marginHorizontal="@dimen/_10sdp"
                />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="@dimen/_90sdp"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/line_color"
        android:layout_marginBottom="@dimen/_5sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/services_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/services_product_list_item"
            android:layout_margin="@dimen/_5sdp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:itemCount="2"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>