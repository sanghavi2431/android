<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".giftcard.GiftCardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/application_background"
        android:orientation="vertical">

        <include layout="@layout/giftcard_titlebar"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/margin_35"
            android:fillViewport="true">

        <LinearLayout
            android:id="@+id/giftAmountLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_semi_bold"
                android:textStyle="normal"
                android:textSize="@dimen/size_9"
                android:textColor="@color/text_color_five"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="-4sp"
                android:gravity="center_horizontal"
                android:text="Add Gift Card Amount" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_semi_bold"
                android:textStyle="normal"
                android:textSize="@dimen/size_6"
                android:textColor="@color/white"
                android:layout_marginLeft="@dimen/margin_5"
                android:layout_marginRight="@dimen/margin_5"
                android:layout_marginTop="@dimen/margin_5"
                android:gravity="center_horizontal"
                android:visibility="visible"
                android:text="@string/Add_Point_text" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_semi_bold"
                android:textStyle="normal"
                android:textSize="@dimen/size_9"
                android:textColor="@color/white"
                android:layout_marginTop="@dimen/margin_5"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="-2.7sp"
                android:gravity="center_horizontal"
                android:visibility="gone"
                android:text="Select the Amount" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_marginLeft="@dimen/margin_5"
                android:layout_marginRight="@dimen/margin_5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHundred"
                        android:layout_width="@dimen/margin_30"
                        android:layout_height="@dimen/margin_20"
                        android:background="@drawable/ic_rupees_not_selected"
                        android:textStyle="normal"
                        android:textSize="@dimen/size_10"
                        android:textColor="@color/white"
                        android:letterSpacing="0.01"
                        android:lineSpacingExtra="-4sp"
                        android:gravity="center"
                        android:text="@string/gift_card_hundred" />

                    <TextView
                        android:id="@+id/tvFiveHundred"
                        android:layout_width="@dimen/margin_30"
                        android:layout_height="@dimen/margin_20"
                        android:background="@drawable/ic_rupees_not_selected"
                        android:textStyle="normal"
                        android:textSize="@dimen/size_10"
                        android:textColor="@color/white"
                        android:letterSpacing="0.01"
                        android:lineSpacingExtra="-4sp"
                        android:layout_marginLeft="@dimen/margin_5"
                        android:gravity="center"
                        android:text="@string/gift_card_five_hundred" />

                    <TextView
                        android:id="@+id/tvThousand"
                        android:layout_width="@dimen/margin_30"
                        android:layout_height="@dimen/margin_20"
                        android:background="@drawable/ic_rupees_not_selected"
                        android:textStyle="normal"
                        android:textSize="@dimen/size_10"
                        android:layout_marginLeft="@dimen/margin_5"
                        android:textColor="@color/white"
                        android:letterSpacing="0.01"
                        android:lineSpacingExtra="-4sp"
                        android:gravity="center"
                        android:text="@string/gift_card_thousands" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_20"
                android:layout_marginLeft="@dimen/margin_10"
                android:layout_marginRight="@dimen/margin_10"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@drawable/rectangle_shape"
                android:padding="@dimen/margin_5"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/margin_8"
                    android:layout_height="@dimen/margin_8"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:src="@drawable/ic_rupee"/>

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:layout_marginLeft="@dimen/margin_3"
                    android:textSize="@dimen/size_8"
                    android:inputType="number"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:digits="1234567890"
                    android:textColor="@color/text_color_one"
                    android:lineSpacingExtra="6.7sp"
                    android:background="@android:color/transparent"
                    android:textColorHint="@color/text_color_one"
                    android:hint="@string/enter_points_manually" />


            </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_20"
                android:layout_marginLeft="@dimen/margin_10"
                android:layout_marginRight="@dimen/margin_10"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@drawable/rectangle_shape"
                android:padding="@dimen/margin_5"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/margin_8"
                    android:layout_height="@dimen/margin_8"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_smartphone"/>

                <EditText
                    android:id="@+id/etMobileNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_3"
                    android:background="@android:color/transparent"
                    android:digits="0123456789"
                    android:hint="@string/mobile_number"
                    android:inputType="number"
                    android:lineSpacingExtra="6.7sp"
                    android:maxLength="13"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/text_color_one"
                    android:textColorHint="@color/text_color_one"
                    android:textSize="@dimen/size_8"
                    android:textStyle="normal" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_10"
                android:layout_marginRight="@dimen/margin_10"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@drawable/rectangle_shape"
                android:padding="@dimen/margin_5"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:textSize="@dimen/size_8"
                    android:gravity="left"
                    android:minLines="3"
                    android:textColor="@color/text_color_one"
                    android:lineSpacingExtra="2sp"
                    android:background="@android:color/transparent"
                    android:textColorHint="@color/text_color_one"
                    android:hint="Enter Message*" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llsendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@drawable/yellow_rectangle_shape"
                android:layout_gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:textSize="@dimen/size_10"
                    android:padding="@dimen/margin_5"
                    android:layout_marginLeft="@dimen/margin_10"
                    android:layout_marginRight="@dimen/margin_10"
                    android:textColor="@color/text_color_one"
                    android:lineSpacingExtra="16.7sp"
                    android:gravity="center_horizontal"
                    android:text="@string/send" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:layout_margin="@dimen/margin_10"
                    android:textSize="@dimen/size_10"
                    android:textColor="@color/text_color_five"
                    android:letterSpacing="0.01"
                    android:lineSpacingExtra="-4sp"
                    android:gravity="center_horizontal"
                    android:text="@string/gift_card_how_it_works" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginLeft="@dimen/margin_20"
                    android:layout_marginRight="@dimen/margin_20">

                    <ImageView
                        android:layout_width="@dimen/margin_7"
                        android:layout_height="@dimen/margin_7"
                        android:src="@drawable/ic_gift_card_works"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="normal"
                        android:textSize="@dimen/size_6"
                        android:textColor="#ffffff"
                        android:lineSpacingExtra="6.7sp"
                        android:layout_marginLeft="@dimen/margin_2"
                        android:text="@string/gift_card_purchase_subscription" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginLeft="@dimen/margin_20"
                    android:layout_marginRight="@dimen/margin_20"
                    android:layout_marginTop="@dimen/margin_5"
                    android:layout_marginBottom="@dimen/margin_5"
                    android:background="@color/seperator_line_color_one"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginLeft="@dimen/margin_20"
                    android:layout_marginRight="@dimen/margin_20">

                    <ImageView
                        android:layout_width="@dimen/margin_7"
                        android:layout_height="@dimen/margin_7"
                        android:src="@drawable/ic_gift_card_works"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="normal"
                        android:textSize="@dimen/size_6"
                        android:textColor="#ffffff"
                        android:lineSpacingExtra="6.7sp"
                        android:layout_marginLeft="@dimen/margin_2"
                        android:text="@string/gift_card_locate_sanitisation_area" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginLeft="@dimen/margin_20"
                    android:layout_marginRight="@dimen/margin_20"
                    android:layout_marginTop="@dimen/margin_5"
                    android:layout_marginBottom="@dimen/margin_5"
                    android:background="@color/seperator_line_color_one"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/margin_20"
                    android:layout_marginLeft="@dimen/margin_20"
                    android:layout_marginRight="@dimen/margin_20">

                    <ImageView
                        android:layout_width="@dimen/margin_7"
                        android:layout_height="@dimen/margin_7"
                        android:src="@drawable/ic_gift_card_works"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="normal"
                        android:textSize="@dimen/size_6"
                        android:textColor="#ffffff"
                        android:lineSpacingExtra="6.7sp"
                        android:layout_marginLeft="@dimen/margin_2"
                        android:layout_marginBottom="@dimen/margin_25"
                        android:text="@string/gift_card_show_code" />

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

        </ScrollView>

    </LinearLayout>


</RelativeLayout>