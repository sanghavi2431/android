<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:layout_gravity="center"
    android:elevation="@dimen/_4sdp"
    android:layout_margin="@dimen/_10sdp"
  >


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp">

        <ImageView
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:src="@drawable/edit_address"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_25sdp"
            android:layout_gravity="center"
            android:id="@+id/image_edit"
            />

    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Write Your Comment"
        android:visibility="visible"
        style="@style/screen_header_text_style_big_left"
        android:maxLines="1"
        android:layout_marginTop="@dimen/_25sdp"
        android:layout_toRightOf="@+id/image_edit"
        />

    </RelativeLayout>

        <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularEditText
            android:id="@+id/tv_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
           android:hint="Add Your Comment Here"
            android:visibility="visible"
            style="@style/ten_black_left"
            android:background="@color/comment_bg"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:padding="@dimen/_10sdp"
            android:maxLines="15"
            android:lines="4"
            />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/yello_rectangle_shape"
            android:text="Add Comment"
           android:layout_marginHorizontal="@dimen/_45sdp"
            android:elevation="@dimen/_4sdp"
            style="@style/screen_header_text_style_big_center_nomargin"
            android:paddingVertical="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_35sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:id="@+id/proceed_to_comment"
            />


    </LinearLayout>

</LinearLayout>