<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_10"
    android:paddingTop="@dimen/margin_10"
    android:paddingEnd="@dimen/margin_10"
    android:paddingBottom="@dimen/margin_10"
    android:elevation="@dimen/_4sdp"
    android:layout_margin="@dimen/_10sdp"
    android:minWidth="340dp">

    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/margin_5"
        android:layout_marginRight="@dimen/margin_5"
        android:gravity="center|top"
        android:text="@string/discontinue_pee_s_club_membership"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_30sdp"
       style="@style/screen_header_text_style_big_center_nomargin" />


    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
        android:id="@+id/discontinueTextTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/margin_6"
        android:layout_marginTop="@dimen/margin_5"
        android:layout_marginRight="@dimen/margin_6"
        android:layout_marginBottom="@dimen/margin_5"
        android:gravity="center"
        android:text="@string/discontinue_text"
       style="@style/twelve_black_nomargin_center"
       />


    <LinearLayout
        android:id="@+id/ll_keep_my_membership"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/margin_5"
        android:background="@drawable/yello_rectangle_shape"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/_30sdp"
        android:padding="@dimen/margin_3">

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/llCancelBtn"
            style="@style/time_nomargin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_10sdp"
            android:elevation="@dimen/_4sdp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_30sdp"
            android:text="keep my membership"
            android:textAllCaps="true" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="@dimen/_5sdp"
        android:gravity="center"
        android:lineSpacingExtra="25.3sp"
        android:paddingLeft="@dimen/margin_10"
        android:paddingRight="@dimen/margin_10"
        android:text="@string/or"
        android:textColor="@color/black"
        android:textSize="@dimen/size_8" />

    <LinearLayout
        android:id="@+id/ll_continue_to_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/_30sdp"
        android:background="@drawable/yello_rectangle_shape"
        android:orientation="horizontal"
        android:backgroundTint="@color/search_background"
        android:layout_marginHorizontal="@dimen/_30sdp"
        android:padding="@dimen/margin_3">

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/llOkayBtn"
            android:text="@string/continue_to_cancle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAllCaps="true"
            android:elevation="@dimen/_4sdp"
            android:layout_margin="@dimen/_10sdp"
            style="@style/time_nomargin" />

    </LinearLayout>
</LinearLayout>

