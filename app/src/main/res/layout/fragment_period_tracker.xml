<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ivBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_5sdp"
            android:gravity="center">

            <ImageView

                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_marginLeft="@dimen/margin_3"
                android:layout_marginTop="@dimen/margin_3"
                android:layout_marginBottom="@dimen/margin_3"
                android:adjustViewBounds="true"
                android:rotation="90"
                android:src="@drawable/down_arrow_bottom_bar"
                />
            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                style="@style/small_gray_style"
                android:text="@string/back"
                android:gravity="center"
                android:layout_margin="@dimen/_2sdp"/>

            <View
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>



        <ScrollView
            android:id="@+id/main_scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="@dimen/_20sdp">


                    <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                    android:id="@+id/tvPeriodInformation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="1dp"
                    android:gravity="center"
                    android:layout_weight="1"
                        style="@style/bottom_woloo_host_header_style"
                        android:text="Your Last Period Date Was \nYour next period cycle starting on 27, Oct 2021, You are currently in Fertility phase." />


                </LinearLayout>
    <LinearLayout
        android:id="@+id/edit_period_date_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="center"
        android:backgroundTint="@color/search_background"
        android:background="@drawable/new_button_background_smallest"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_5sdp"
        android:paddingHorizontal="@dimen/_20sdp">

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/edit_period_date" />

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:gravity="center_vertical"
            style="@style/twelve_black_nomargin_center"
            android:text="Edit Period Date" />
    </LinearLayout>


</LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                    <in.woloo.www.more.period_tracker.circular_calender.PeriodCalendarView
                        android:id="@+id/periodCalendar"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:scaleType="centerCrop"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                       />

                    <ImageView
                        android:id="@+id/show_info_dialog"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/about_us_icon"
                        android:layout_marginRight="@dimen/_25sdp"
                        android:layout_marginTop="@dimen/_15sdp"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_gravity="center"
                        tools:ignore="MissingConstraints" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/view1"
                        android:layout_width="@dimen/_8sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_3sdp"
                        android:background="@drawable/new_button_background_square"
                        android:backgroundTint="@color/menturation_cycle"
                        />



                    <TextView
                        android:id="@+id/textView1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Period"
                        android:textSize="12sp"
                        />

                    <View
                        android:id="@+id/view"
                        android:layout_width="@dimen/_8sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:background="@drawable/new_button_background_square"
                        android:backgroundTint="@color/ovalution_cycle"
                        android:layout_marginEnd="@dimen/_3sdp"
                        />


                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ovulation"
                        android:textSize="12sp"
                        />

                    <View
                        android:id="@+id/view2"
                        android:layout_width="@dimen/_8sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/new_button_background_square"
                        android:backgroundTint="@color/pregnancy_cycle"
                        android:layout_marginEnd="@dimen/_3sdp"
                        />


                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High Fertility"
                        android:textSize="12sp"
                        />

                    <View
                        android:id="@+id/view4"
                        android:layout_width="@dimen/_8sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:background="@drawable/new_button_background_square"
                        android:backgroundTint="@color/normal_cycle"
                        android:layout_marginEnd="@dimen/_3sdp"
                        />


                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        android:textSize="12sp"
                        />
                    <View
                        android:id="@+id/view5"
                        android:layout_width="@dimen/_8sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:background="@drawable/new_button_background_square"
                        android:backgroundTint="@color/next_month"
                        android:layout_marginEnd="@dimen/_3sdp"
                        />


                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upcoming"
                        android:textSize="12sp"
                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:background="@drawable/calendar_bg"
                    android:elevation="@dimen/_4sdp"
                    android:layout_weight="2"
                    android:layout_margin="@dimen/_10sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/calender_header_bg"
                        android:clipToOutline="true"
                        android:gravity="center"
                       >
                        <ImageView
                            android:id="@+id/prev_month"
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:src="@drawable/down_arrow_bottom_bar"
                            android:rotation="90"/>
                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/month_display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                           android:paddingVertical="@dimen/_10sdp"
                            style="@style/twelve_black_nomargin_center"
                            android:layout_marginHorizontal="@dimen/_20sdp"
                            />

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/year_display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="2025"
                            android:visibility="gone"
                            />

                        <ImageView
                            android:id="@+id/next_month"
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:src="@drawable/down_arrow_bottom_bar"
                            android:rotation="270"/>


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/weekdays_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_margin="@dimen/_5sdp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:gravity="center">

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="S"
                            style="@style/calendar_text_style_center"
                             />

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="M"
                            style="@style/calendar_text_style_center"/>

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="T"
                            style="@style/calendar_text_style_center" />

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="W"
                            style="@style/calendar_text_style_center" />

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="T"
                            style="@style/calendar_text_style_center" />

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="F"
                            style="@style/calendar_text_style_center" />

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="S"
                            style="@style/calendar_text_style_center" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/search_background"
                        android:layout_marginHorizontal="@dimen/_10sdp"/>


                    <!-- Calendar grid -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/calendarViewPager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_margin="@dimen/_5sdp"/>

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/yellow_rectangle_shape_less_round"
                    android:paddingHorizontal="@dimen/_5sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_60sdp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/_10sdp"
                        android:background="@drawable/yellow_rectangle_shape_less_round"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start"
                                android:layout_marginStart="@dimen/margin_5"
                                android:layout_marginTop="@dimen/margin_5"
                                android:layout_marginEnd="@dimen/margin_5"
                                android:layout_marginBottom="@dimen/margin_5"
                                android:text="@string/daily_log"
                                android:textColor="@color/gray"
                                android:textSize="@dimen/size_8"
                                android:textStyle="bold" />

                            <FrameLayout
                                android:id="@+id/add_daily_log_fl"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_margin="@dimen/margin_5"
                                android:background="@drawable/rounded_background_dark_gray"
                                android:padding="@dimen/margin_2">

                                <ImageView
                                    android:id="@+id/add_daily_log_Imv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_plus_yellow" />
                            </FrameLayout>


                        </RelativeLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/dailyLog_Rv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_3"
                                android:layout_marginEnd="@dimen/margin_3"
                                android:layout_marginBottom="@dimen/margin_5"
                                android:orientation="horizontal"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                            <TextView
                                android:id="@+id/no_data_available_Tv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/margin_5"
                                android:gravity="center"
                                android:text="@string/no_symptoms"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/margin_10"
                    android:layout_marginBottom="@dimen/margin_4"
                    android:fontFamily="@font/open_sans_semi_bold"
                    android:text="Blogs"
                    android:textColor="#414042"
                    android:textSize="@dimen/size_9"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBlogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_45"
                    android:background="@color/white"
                    android:visibility="gone"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>