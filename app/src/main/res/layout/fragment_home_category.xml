<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:id="@+id/process_bar_view"
    tools:context=".application_kotlin.presentation.fragments.loo_discovery.HomeCategoryFragment">




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/dotLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="@dimen/_2sdp"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginRight="@dimen/_15sdp"
                android:layout_gravity="center_horizontal"
                android:layout_above="@+id/pullToRefreshLayout"
                android:visibility="gone"
                />


            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHomeCategory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:scrollbars="none"
                tools:listitem="@layout/home_category_fragment_adapter_item" />

                <LinearLayout
                    android:id="@+id/show_more_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_97sdp"
                    android:elevation="@dimen/_4sdp"
                    android:layout_toEndOf="@+id/rvHomeCategory"
                    android:layout_centerVertical="true"
                    android:background="@drawable/new_button_background"
                    android:orientation="horizontal"
                    android:padding="@dimen/_5sdp"
                    android:visibility="gone"
                    android:layout_marginHorizontal="@dimen/_8sdp"
                    android:layout_marginVertical="@dimen/_20sdp"
                   >

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_85sdp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/tv2Km"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2 kms"
                            android:layout_weight="1"
                            style="@style/small_button_style"
                            android:paddingVertical="@dimen/_2sdp"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_marginVertical="@dimen/_2sdp"
                            android:background="@drawable/yello_rectangle_shape"/>

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/tv5Km"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="5 kms"
                            android:layout_weight="1"
                            style="@style/small_button_style"
                            android:paddingVertical="@dimen/_2sdp"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_marginVertical="@dimen/_2sdp"
                            android:background="@drawable/yello_rectangle_shape"/>

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/tv10Km"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="10 kms"
                            android:layout_weight="1"
                            style="@style/small_button_style"
                            android:paddingVertical="@dimen/_2sdp"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_marginVertical="@dimen/_2sdp"
                            android:visibility="gone"
                            android:background="@drawable/yello_rectangle_shape"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_85sdp"
                        android:orientation="vertical"
                        android:layout_weight="1">

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/tv4Km"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="4 kms"
                            android:layout_weight="1"
                            style="@style/small_button_style"
                            android:paddingVertical="@dimen/_2sdp"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:layout_marginRight="@dimen/_10sdp"
                            android:layout_marginVertical="@dimen/_2sdp"
                            android:background="@drawable/yello_rectangle_shape"/>

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/tv6Km"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="6 kms"
                            android:layout_weight="1"
                            style="@style/small_button_style"
                            android:paddingVertical="@dimen/_2sdp"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:layout_marginRight="@dimen/_10sdp"
                            android:layout_marginVertical="@dimen/_2sdp"
                            android:background="@drawable/yello_rectangle_shape"/>


                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/tv8Km"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="8 kms"
                            android:layout_weight="1"
                            style="@style/small_button_style"
                            android:paddingVertical="@dimen/_2sdp"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:layout_marginRight="@dimen/_10sdp"
                            android:layout_marginVertical="@dimen/_2sdp"
                            android:visibility="gone"
                            android:background="@drawable/yello_rectangle_shape"/>

                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/tv25Km"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="25 kms"
                            android:layout_weight="1"
                            style="@style/small_button_style"
                            android:paddingVertical="@dimen/_2sdp"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:layout_marginRight="@dimen/_10sdp"
                            android:layout_marginVertical="@dimen/_2sdp"
                            android:visibility="gone"
                            android:background="@drawable/yello_rectangle_shape"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tv_search_more"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_85sdp"
                        android:orientation="vertical"
                        android:layout_gravity="center"
                        android:gravity="center">

            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView

                android:text="Show More"
                android:layout_toRightOf="@+id/rvHomeCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_4sdp"
                android:gravity="center"
                android:layout_alignParentBottom="true"
                style="@style/screen_header_text_style_15_center"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingVertical="@dimen/_15sdp"
                android:layout_marginHorizontal="@dimen/_5sdp"
                />
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/show_more_arrow"
                            android:layout_marginHorizontal="@dimen/_10sdp"/>

                </LinearLayout>

                </LinearLayout>

            </androidx.coordinatorlayout.widget.CoordinatorLayout>


        </LinearLayout>




    <LinearLayout
        android:id="@+id/tvNoWolooFound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_10"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_no_woloo_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/no_woloo_found"
            android:textColor="@color/text_color"
            android:textSize="@dimen/size_7"
            android:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_2"
            android:layout_marginTop="@dimen/margin_5"
            android:layout_marginBottom="@dimen/margin_5"
            android:background="@color/gray" />

        <TextView
            android:id="@+id/tv_no_woloo_search_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/click_search_no_woloo_found"
            android:textColor="@color/text_color_four"
            android:textSize="@dimen/size_7"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tv_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/margin_5"
            android:background="@drawable/yellow_rectangle_shape"
            android:gravity="center"
            android:paddingLeft="@dimen/margin_5"
            android:paddingTop="@dimen/margin_2"
            android:paddingRight="@dimen/margin_5"
            android:paddingBottom="@dimen/margin_2"
            android:singleLine="true"
            android:text="Search"
            android:textColor="@color/text_color_one"
            android:textSize="@dimen/size_7"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>