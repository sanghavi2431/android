<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:elevation="@dimen/_4sdp"
    android:layout_margin="@dimen/_10sdp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/botton_nav_floating_bg"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp">

        <!--        <ImageView-->
        <!--            android:layout_width="@dimen/margin_40"-->
        <!--            android:layout_height="@dimen/margin_40"-->
        <!--            android:layout_centerHorizontal="true"-->
        <!--            android:layout_gravity="center"-->
        <!--            android:layout_marginTop="@dimen/margin_5"-->
        <!--            android:layout_marginBottom="@dimen/margin_3"-->
        <!--            android:src="@drawable/ic_wl_logo" />-->


        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="@dimen/_55sdp"
            android:layout_gravity="center"
            android:src="@drawable/gift_received" />

        <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/margin_5"
            android:layout_marginRight="@dimen/margin_5"
            android:layout_marginBottom="@dimen/margin_5"
            android:gravity="center_horizontal"
            android:text="Test Description"
            style="@style/twelve_black_nomargin_center" />

        <LinearLayout
            android:id="@+id/llStartFreeTrial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/margin_5"
            android:layout_marginBottom="@dimen/margin_5"
            android:background="@drawable/yellow_rectangle_shape"
            android:orientation="horizontal"
            android:padding="@dimen/margin_3">

            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_20sdp"
                android:text="@string/okay"
                style="@style/button_text_style"
               />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>