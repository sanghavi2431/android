<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".boarding.BoardingActivity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/dotRel">
        <LinearLayout
            android:id="@+id/dotSliderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentTop="true"
            android:layout_marginTop="@dimen/margin_1"
            android:gravity="center"/>
    </RelativeLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/boardingViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/dotRel"
        android:layout_above="@+id/skipTextSlider"/>
   <TextView
       android:id="@+id/skipTextSlider"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="left"
       android:text="@string/skip"
       android:layout_alignParentBottom="true"
       android:layout_alignParentLeft="true"
       android:fontFamily="@font/open_sans_regular"
       android:textColor="@color/skip_text_color"
       android:layout_marginLeft="@dimen/margin_10"
       android:layout_marginBottom="@dimen/margin_13"
       android:textSize="16sp"/>
    <ImageButton
        android:id="@+id/nextSliderButton"
        android:layout_width="@dimen/margin_18"
        android:layout_height="@dimen/margin_18"
        android:background="@drawable/circle_button"
        android:src="@drawable/ic_baseline_keyboard_arrow_right"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="@dimen/margin_10"
        android:layout_marginBottom="@dimen/margin_10"
        />
    <TextView
        android:id="@+id/boardingActivityAuthenticate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Get Started"
        android:textAlignment="center"
        android:layout_below="@+id/skipTextSlider"
        android:layout_alignParentBottom="true"
        android:textSize="@dimen/size_10"
        android:padding="@dimen/margin_5"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_marginRight="@dimen/margin_8"
        android:layout_marginBottom="@dimen/margin_6"
        android:layout_marginLeft="@dimen/margin_8"
        android:visibility="gone"
        android:background="@drawable/round_corner_button"

        />


</RelativeLayout>