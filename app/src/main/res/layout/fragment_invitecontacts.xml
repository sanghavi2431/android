<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".invite_friend.fragments.InviteContactsFragments">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white_95"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ivBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:gravity="center">
            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_7sdp"
                android:adjustViewBounds="true"
                android:rotation="90"
                android:layout_gravity="center"
                android:src="@drawable/down_arrow_bottom_bar" />
            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/small_gray_style"
                android:text="@string/back"
                android:gravity="center"
                />
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_15sdp">
            <ImageView
                android:id="@+id/screen_image"
                android:layout_width="@dimen/_45sdp"
                android:layout_height="@dimen/_45sdp"
                android:src="@drawable/refer_icon"
                android:layout_marginRight="@dimen/_15sdp"
                android:layout_gravity="center" />
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:id="@+id/screen_header"
                    style="@style/screen_header_text_style_big_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/inv_contacts"  />
                <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                    android:id="@+id/screen_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/screen_header"
                    android:text="@string/check_out_refer"
                    style="@style/screen_sub_header_text_left"
                    android:paddingVertical="@dimen/_2sdp"
                    />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/new_button_background"
                android:elevation="@dimen/_4sdp"
               android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_marginVertical="@dimen/_10sdp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivSearch"
                    android:src="@drawable/ic_search_icon"
                    android:layout_gravity="center"
                    android:padding="@dimen/margin_2"
                    android:layout_width="@dimen/margin_10"
                    android:layout_height="@dimen/margin_10"/>

                <in.woloo.www.application_kotlin.utilities.CenturiGothicBoldEditText
                    android:id="@+id/edit_search"
                    android:text=""
                    android:textStyle="bold"
                    android:textSize="@dimen/size_5"
                    android:textColor="@color/black"
                    android:padding="@dimen/margin_5"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:hint="Search by Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rl_works"
            >

        <in.woloo.www.more.subscribe.mvp.EmptyRecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="blocksDescendants"
            android:id="@+id/recyclerView_invitecontacts"
            android:layout_above="@id/tvInvite"
            android:layout_marginHorizontal="@dimen/_10sdp"
            />

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/tvInvite"
            android:text="Invite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            style="@style/dialog_button_text_style"
            android:layout_gravity="center"
            android:layout_alignParentBottom="true"
            android:layout_marginVertical="@dimen/_5sdp"
            android:background="@drawable/yellow_rectangle_shape"/>
        </RelativeLayout>

    </LinearLayout>
</RelativeLayout>