<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_170sdp"
    android:layout_height="@dimen/_170sdp"
    android:orientation="vertical">
<androidx.cardview.widget.CardView
    android:layout_width="@dimen/_150sdp"
    android:layout_height="@dimen/_150sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:backgroundTint="@color/subscription_dialog_button_color"
    app:cardCornerRadius="@dimen/_15sdp"
    android:elevation="@dimen/_4sdp"
    android:layout_marginHorizontal="@dimen/_5sdp"
    >
    <RelativeLayout
        android:layout_width="@dimen/_150sdp"
        android:layout_height="@dimen/_150sdp"
        >
<View
    android:layout_width="@dimen/_130sdp"
    android:layout_height="@dimen/_25sdp"
    android:layout_marginHorizontal="@dimen/_10sdp"
    android:layout_marginVertical="@dimen/_10sdp"
    android:paddingTop="@dimen/_15sdp"
    android:background="@drawable/rounded_rectangle_line"
    android:layout_alignParentTop="true"
    />

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/woloo_host_name"
            style="@style/overlay_style_small"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:paddingTop="@dimen/_18sdp"
            android:layout_gravity="center"
            android:gravity="center"
            android:id="@+id/woloo_host_name"
            android:singleLine="true"
            android:maxLines="1"
           />

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="open now"

            style="@style/screen_sub_header_text_center"
            android:layout_centerHorizontal="true"
            android:id="@+id/open_now_buttton"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_2sdp"
            android:layout_margin="@dimen/_4sdp"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_below="@+id/woloo_host_name"
            android:background="@drawable/yello_rectangle_shape"
            />
        
        <ImageView
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:layout_gravity="center"
            android:layout_centerHorizontal="true"
            android:layout_margin="@dimen/_2sdp"
            android:src="@drawable/navigation_icon"
            android:id="@+id/navigation_icon_pop_up"
            android:layout_below="@+id/open_now_buttton"/>

            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Take Me Here"
                style="@style/overlay_style"
                android:paddingHorizontal="@dimen/_10sdp"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_below="@+id/navigation_icon_pop_up"
                android:layout_centerHorizontal="true"
                android:id="@+id/take_me_here_button"
                />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_below="@+id/take_me_here_button">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_gravity="bottom"
                android:elevation="@dimen/_1sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                >
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    >
                <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="time"
                    android:id="@+id/walking_time"
                    style="@style/overlay_style_small"
                    android:layout_margin="@dimen/_1sdp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    />
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:src="@drawable/navigation_icon"
                        android:layout_centerHorizontal="true"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:layout_below="@+id/walking_time"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="time"
                        android:id="@+id/bike_time"
                        style="@style/overlay_style_small"
                        android:layout_margin="@dimen/_1sdp"
                        android:gravity="center"
                        android:layout_gravity="center"
                        />
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:src="@drawable/navigation_icon"
                        android:layout_centerHorizontal="true"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:layout_below="@+id/bike_time"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="time"
                        android:id="@+id/car_time"
                        style="@style/overlay_style_small"
                        android:layout_margin="@dimen/_1sdp"
                        android:gravity="center"
                        android:layout_gravity="center"
                        />
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:src="@drawable/navigation_icon"
                        android:layout_centerHorizontal="true"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:layout_below="@+id/car_time"/>
                </RelativeLayout>
            </LinearLayout>

    <View
        android:layout_width="@dimen/_130sdp"
        android:layout_height="@dimen/_25sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:background="@drawable/rounded_rectangle_bottom_line"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/_10sdp"
        />

        </FrameLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
    <ImageView
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:src="@drawable/triangle_shape"
        android:layout_gravity="center_horizontal"
        android:rotation="180"
        />
</LinearLayout>