<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".store.screens.StoreListingFragment"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_61sdp"
        android:background="@drawable/bottom_rounded_corners"
        android:backgroundTint="@color/start_theme_color"
        android:layout_gravity="top"
        android:id="@+id/logo_layout"
        android:elevation="@dimen/_5sdp">
        <ImageView
            android:layout_width="@dimen/_62sdp"
            android:layout_height="@dimen/_44sdp"
            android:src="@drawable/woloo_powder_room_logo"
            android:layout_centerInParent="true"
            />
    </RelativeLayout>

    <LinearLayout
        android:layout_gravity="top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/logo_layout"
        android:elevation="@dimen/_1sdp"
        android:background="@drawable/header_layout_shop_background">
        <LinearLayout
            android:id="@+id/address_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:layout_marginTop="@dimen/_11sdp"
            android:layout_marginBottom="@dimen/_5sdp">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:id="@+id/home_text"
                    style="@style/refer_3_host_style"
                    android:layout_width="336dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/_3sdp"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_below="@+id/home_text">
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:id="@+id/address_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/nine_left_chip"
                        android:paddingStart="@dimen/_3sdp"
                        android:layout_gravity="center_vertical"
                        android:maxLines="1"
                        android:maxLength="40"
                        />
                    <ImageView
                        android:id="@+id/show_all_address"
                        android:layout_width="@dimen/_13sdp"
                        android:layout_height="@dimen/_13sdp"
                        android:src="@drawable/down_navigate_arrow"
                        android:layout_toEndOf="@+id/address_text"
                        android:layout_margin="@dimen/_5sdp"
                        android:layout_gravity="center_vertical"
                        />
                </LinearLayout>
            </RelativeLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/go_to_cart_view">
                <View
                    android:layout_width="@dimen/_31sdp"
                    android:layout_height="@dimen/_31sdp"
                    android:background="@drawable/imagecircle"
                    android:backgroundTint="@color/search_background"
                    android:layout_gravity="center"/>
                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/shop_icon_bottom_nav"
                    android:layout_gravity="center"/>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|right"
                    >
                    <View
                        android:layout_width="@dimen/_13sdp"
                        android:layout_height="@dimen/_13sdp"
                        android:background="@drawable/imagecircle"
                        android:backgroundTint="@color/start_theme_color"
                        android:layout_gravity="center"
                        />
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="0"
                        android:layout_gravity="center"
                        style="@style/time_nomargin"
                        android:id="@+id/display_cart_count"/>

                </FrameLayout>

            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/search_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/new_button_background"
            android:elevation="@dimen/_4sdp"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_15sdp"
            android:layout_below="@+id/address_layout">
            <ImageView
                android:id="@+id/search_image"
                android:layout_width="@dimen/_23sdp"
                android:layout_height="@dimen/_18sdp"
                android:src="@drawable/search_icon_home"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginVertical="@dimen/_7sdp"
                />
            <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                android:id="@+id/search_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Search Products"
                style="@style/twelve_chip_left"
                android:layout_marginStart="@dimen/_10sdp"
                android:background="@color/transparent"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/logo_layout"
        android:clipToPadding="false"
        android:paddingTop="0dp"
        android:overScrollMode="always"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/_125sdp"
            android:layout_marginBottom="@dimen/_70sdp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp">
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Services"
                        style="@style/pop_up_left"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_2sdp"
                        />
                    <RelativeLayout
                        android:id="@+id/see_more_brands_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true">
                        <TextView
                            android:id="@+id/see_more_brands"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/see_more" />
                        <ImageView
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:src="@drawable/down_navigate_arrow"
                            android:rotation="270"
                            android:layout_toRightOf="@+id/see_more_brands"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="@dimen/_10sdp" />
                    </RelativeLayout>

                </RelativeLayout>
                <View
                    android:layout_width="@dimen/_90sdp"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:background="@color/light_gray"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
               <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/services_categories_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:itemCount="9"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="3"
                    tools:listitem="@layout/services_categories_list_adapter"
                    android:layout_margin="@dimen/_10sdp"
                    android:elevation="@dimen/_4sdp"
                    android:background="@drawable/new_button_background_square" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5sdp"
                android:gravity="center"
                >
                <RelativeLayout
                    android:id="@+id/show_orders_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/yello_rectangle_shape"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:layout_marginRight="@dimen/_5sdp"
                    >
                    <ImageView
                        android:id="@+id/orders_img"
                        android:layout_width="@dimen/_21sdp"
                        android:layout_height="@dimen/_21sdp"
                        android:src="@drawable/shop_bag_orders"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="@dimen/_10sdp"/>
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orders"
                        android:layout_toRightOf="@id/orders_img"
                        android:layout_centerVertical="true"
                        style="@style/ten_black_center"/>


                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/show_favourites_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/yello_rectangle_shape"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_toRightOf="@+id/show_orders_list"
                    >
                    <ImageView
                        android:id="@+id/favorite_selected_img"
                        android:layout_width="@dimen/_21sdp"
                        android:layout_height="@dimen/_21sdp"
                        android:src="@drawable/heart_shop_list"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="@dimen/_10sdp"/>
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Favourites"
                        android:layout_toRightOf="@id/favorite_selected_img"
                        android:layout_centerVertical="true"
                        style="@style/ten_black_center"/>


                </RelativeLayout>


            </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp">
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Express Booking"
                        style="@style/pop_up_left"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_2sdp"
                        />
                    <RelativeLayout
                        android:id="@+id/see_more_express_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                       android:visibility="gone"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true">
                        <TextView
                            android:id="@+id/see_more_express_services"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/see_more" />
                        <ImageView
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:src="@drawable/down_navigate_arrow"
                            android:rotation="270"
                            android:layout_toRightOf="@+id/see_more_express_services"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="@dimen/_10sdp" />
                    </RelativeLayout>

                </RelativeLayout>
                <View
                    android:layout_width="@dimen/_90sdp"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:background="@color/light_gray"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/services_express_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:itemCount="3"
                        tools:listitem="@layout/express_services_list_item"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp">
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Take a Sneak Peek"
                        style="@style/pop_up_left"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_2sdp"
                        />

                </RelativeLayout>
                <View
                    android:layout_width="@dimen/_90sdp"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:background="@color/light_gray"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/services_sneak_peek_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:itemCount="3"
                        app:spanCount="3"
                        tools:listitem="@layout/take_sneak_peek_list_item"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal"
                        />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>