<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:cardview="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewParent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/white"
    cardview:cardCornerRadius="@dimen/_10sdp"
    cardview:cardElevation="@dimen/_4sdp"
    android:layout_marginTop="@dimen/_7sdp"
    android:layout_marginBottom="@dimen/_7sdp"
    android:layout_marginHorizontal="@dimen/_10sdp"

    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_10sdp">

        <ImageView
            android:id="@+id/bottom_host_image"
            android:layout_width="@dimen/_17sdp"
            android:layout_height="@dimen/_17sdp"
            android:background="@drawable/select_address_empty"
            android:padding="@dimen/_2sdp"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:layout_gravity="center_vertical"
            android:layout_margin="@dimen/_8sdp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginVertical="@dimen/_8sdp">
            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Home"
                style="@style/refer_3_host_style"
                android:maxLines="1"
                android:layout_marginLeft="@dimen/_5sdp"
                android:id="@+id/address_name"/>

            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1234 Lane road, Area, Location, Landmark"
                style="@style/nine_left_chip"
                android:maxLines="3"
                android:layout_marginLeft="@dimen/_5sdp"
                android:id="@+id/address_text"/>


        </LinearLayout>


        <ImageView
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:src="@drawable/delete_icon"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:id="@+id/delete_address_button"
            />


        <ImageView
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:src="@drawable/edit_address"
                android:layout_gravity="center_vertical"

            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginLeft="@dimen/_5sdp"
                android:id="@+id/edit_address_button"
                />






    </LinearLayout>
</androidx.cardview.widget.CardView>