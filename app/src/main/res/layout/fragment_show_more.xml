<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/top_corner_dialog_bg"
    android:elevation="@dimen/_4sdp"
    android:orientation="vertical"
    app:layout_behavior="@string/bottom_sheet_behavior"
    android:paddingTop="@dimen/_10sdp"
    tools:context=".application_kotlin.presentation.activities.loo_discovery.SearchActivity">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

    <LinearLayout
        android:id="@+id/search_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
       >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/_5sdp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:src="@drawable/ic_left_arrow"
                android:layout_marginStart="@dimen/margin_5"/>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rectangle_shape"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginHorizontal="@dimen/margin_5"
                android:weightSum="10">

                <AutoCompleteTextView
                    android:id="@+id/search_auto_complete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="2"
                    android:drawableStart="@drawable/ic_search_icon"
                    android:drawablePadding="4.6dp"
                    android:hint="@string/search_by_location"
                    android:inputType="text"
                    android:padding="@dimen/margin_3"
                    android:text=""
                    android:background="@drawable/rectangle_shape"
                    android:imeOptions="actionDone"
                    android:textColor="@color/black"
                    android:textSize="@dimen/size_5"
                    android:textStyle="bold"
                    android:layout_weight="9"/>

                <ImageView
                    android:id="@+id/iv_cancel"
                    android:layout_width="@dimen/size_10"
                    android:layout_height="@dimen/size_10"
                    android:src="@drawable/ic_close"
                    app:tint="@color/black"
                    android:layout_marginHorizontal="@dimen/margin_3"
                    android:layout_weight="1"/>
            </androidx.appcompat.widget.LinearLayoutCompat>


        </LinearLayout>

       <View
           android:id="@+id/back_dialog"
           android:layout_width="@dimen/_50sdp"
           android:layout_height="@dimen/_3sdp"
           android:background="@color/chip_color"
            android:padding="@dimen/_5sdp"
           android:layout_marginBottom="@dimen/_25sdp"
           android:layout_marginTop="@dimen/_5sdp"
           android:layout_gravity="center_horizontal"/>


        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Most Hosts Near You"
            style="@style/screen_header_text_style_big_center"
            />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="@dimen/_25sdp">
            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:id="@+id/cbOpenNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Open Now"
                android:layout_weight="1"
                style="@style/small_button_style"
                android:background="@drawable/yello_rectangle_shape"
                android:layout_marginLeft="@dimen/_2sdp"
                android:layout_marginRight="@dimen/_5sdp"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:layout_gravity="center"/>
            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:id="@+id/cbBookmarkedWoloo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Bookmarked"
                android:layout_weight="1"
                style="@style/small_button_style"
                android:background="@drawable/yello_rectangle_shape"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginRight="@dimen/_5sdp"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:layout_gravity="center"/>
            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/cbWolooWithOffers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Offers Availables"
            android:layout_weight="1"
            style="@style/small_button_style"
            android:background="@drawable/yello_rectangle_shape"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_2sdp"
            android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_6sdp"
            android:layout_gravity="center"
                android:visibility="gone"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:backgroundTint="@color/line_more"
            android:background="@drawable/new_button_background"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_marginVertical="@dimen/_15sdp"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_5sdp"
            android:layout_marginHorizontal="@dimen/_25sdp">

            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search Within"
                style="@style/ten_black_left"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textView7"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="@dimen/margin_3"
                android:scrollbars="none"
                app:layout_constraintHorizontal_bias="1">

                <LinearLayout
                    android:id="@+id/distance_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_2km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 Km"
                        android:drawablePadding="@dimen/_2sdp"
                        android:drawableLeft="@drawable/marker_gray"
                        android:drawableTint="@color/black"
                        android:background="@drawable/yello_rectangle_shape"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        style="@style/small_button_style"
                        android:layout_marginRight="@dimen/_5sdp"/>

                    <TextView
                        android:id="@+id/tv_4km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/_2sdp"
                        android:drawableLeft="@drawable/marker_gray"
                        android:drawableTint="@color/black"
                        android:background="@drawable/rounded_gray_bg"
                        android:text="4 Km"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        style="@style/small_button_style"
                        android:layout_marginRight="@dimen/_5sdp"/>

                    <TextView
                        android:id="@+id/tv_5km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/_2sdp"
                        android:drawableLeft="@drawable/marker_gray"
                        android:drawableTint="@color/black"
                        android:background="@drawable/rounded_gray_bg"
                        android:text="5 Km"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        style="@style/small_button_style"
                        android:layout_marginRight="@dimen/_5sdp" />


                    <TextView
                        android:id="@+id/tv_6km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/_2sdp"
                        android:drawableLeft="@drawable/marker_gray"
                        android:drawableTint="@color/black"
                        android:background="@drawable/rounded_gray_bg"
                        android:text="6 Km"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        style="@style/small_button_style"
                        android:layout_marginRight="@dimen/_5sdp" />

                    <TextView
                        android:visibility="gone"
                        android:id="@+id/tv_8km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/_2sdp"
                        android:drawableLeft="@drawable/marker_gray"
                        android:drawableTint="@color/black"
                        android:background="@drawable/rounded_gray_bg"
                        android:text="8 Km"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        style="@style/small_button_style"

                        android:layout_marginRight="@dimen/_5sdp" />

                    <TextView
                        android:visibility="gone"
                        android:id="@+id/tv_10km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/_2sdp"
                        android:drawableLeft="@drawable/marker_gray"
                        android:drawableTint="@color/black"
                        android:background="@drawable/rounded_gray_bg"
                        android:text="10 Km"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        style="@style/small_button_style"
                        android:layout_marginRight="@dimen/_5sdp" />

                    <TextView
                        android:visibility="gone"
                        android:id="@+id/tv_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/_2sdp"
                        android:drawableLeft="@drawable/marker_gray"
                        android:drawableTint="@color/black"
                        android:background="@drawable/rounded_gray_bg"
                        android:text="25 Km"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        style="@style/small_button_style"
                        android:layout_marginRight="@dimen/_5sdp" />


                </LinearLayout>
            </HorizontalScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_layout">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
           >

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/wolooRv"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:visibility="gone"
                tools:listitem="@layout/home_category_fragment_adapter_item"/>

            <LinearLayout
                android:id="@+id/tvNoWolooFound"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/margin_10"
                android:orientation="vertical"

               >

                <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                    android:id="@+id/tvNoWolooText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/no_woloo_found"
                    style="@style/twelve_black_nomargin_center"
                     />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_2"
                    android:layout_marginTop="@dimen/margin_5"
                    android:layout_marginBottom="@dimen/margin_5"
                    android:background="@color/gray"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/click_search_no_woloo_found"
                    android:textColor="@color/text_color_four"
                    android:textSize="@dimen/size_7"
                    android:visibility="gone" />

            </LinearLayout>

        </FrameLayout>
    </FrameLayout>
        </LinearLayout>
</RelativeLayout>