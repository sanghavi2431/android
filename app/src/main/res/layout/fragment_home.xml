<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_map"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".dashboard.WolooDashboard">

    <LinearLayout
        android:id="@+id/search_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rectangle_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginHorizontal="@dimen/margin_5"
            android:layout_marginTop="@dimen/margin_5"
            android:weightSum="10">

            <AutoCompleteTextView
                android:id="@+id/search_auto_complete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="2"
                android:drawableStart="@drawable/ic_search_icon"
                android:drawablePadding="4.6dp"
                android:hint="@string/search_by_location"
                android:inputType="text"
                android:padding="@dimen/margin_3"
                android:text=""
                android:background="@drawable/rectangle_shape"
                android:imeOptions="actionDone"
                android:textColor="@color/black"
                android:textSize="@dimen/size_5"
                android:textStyle="bold"
                android:layout_weight="9"/>

            <ImageView
                android:id="@+id/iv_cancel"
                android:layout_width="@dimen/size_10"
                android:layout_height="@dimen/size_10"
                android:src="@drawable/ic_close"
                app:tint="@color/black"
                android:layout_marginHorizontal="@dimen/margin_3"
                android:layout_weight="1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>


        <include
            android:id="@+id/search_option_layout"
            layout="@layout/search_options"/>

    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/search_layout"
        android:fillViewport="true"
        android:visibility="gone">

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:weightSum="2">

            <FrameLayout
                android:id="@+id/frm_home_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="visible">

                <fragment
                    android:id="@+id/map"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tv_woloo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|bottom"
                    android:background="@color/transparent_black_90"
                    android:drawableTop="@drawable/rounded_yellow_bg"
                    android:paddingTop="@dimen/margin_2"
                    android:text="Click Here"
                    android:textColor="@color/app_background"
                    android:textSize="@dimen/size_6"
                    android:gravity="center" />

                <LinearLayout
                    android:id="@+id/unselected_transport_mode_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_marginTop="@dimen/margin_20"
                    android:layout_marginRight="@dimen/margin_2"
                    android:background="@drawable/circle_shape_background_yellow"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/bicycle_mode"
                        android:layout_width="@dimen/margin_15"
                        android:layout_height="@dimen/margin_15"
                        android:visibility="gone"
                        android:src="@drawable/bicycle_unselected_transport_mode" />

                    <ImageView
                        android:id="@+id/walking_mode"
                        android:layout_width="@dimen/margin_15"
                        android:layout_height="@dimen/margin_15"
                        android:src="@drawable/walking_unselected_transport_mode" />

                    <ImageView
                        android:id="@+id/car_mode"
                        android:layout_width="@dimen/margin_15"
                        android:layout_height="@dimen/margin_15"
                        android:src="@drawable/car_unselected_transport_mode" />

                    <ImageView
                        android:id="@+id/cancel_mode_icon"
                        android:layout_width="@dimen/margin_5"
                        android:layout_height="@dimen/margin_5"
                        android:layout_gravity="center"
                        android:layout_marginRight="@dimen/margin_4"
                        android:src="@drawable/ic_cancel_icon" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/selected_transport_mode_layout"
                    android:layout_width="@dimen/margin_15"
                    android:layout_height="@dimen/margin_15"
                    android:layout_gravity="right"
                    android:layout_marginTop="@dimen/margin_20"
                    android:layout_marginRight="@dimen/margin_2"
                    android:src="@drawable/walking_unselected_transport_mode"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/contact_us"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@android:drawable/ic_menu_call"
                    android:layout_gravity="right|top"
                    android:layout_marginTop="@dimen/margin_40"
                    android:layout_marginRight="@dimen/margin_2"
                    android:padding="3dp"
                    android:background="@drawable/call_icon"
                    />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/frm_home_data"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone">

                <fragment
                    android:id="@+id/fragment_map"
                    android:name="in.woloo.www.home.fragments.HomeCategoryFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frm_dialog_sos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone">

               <include
                   layout="@layout/dialog_sos_category"
                   android:layout_width="match_parent"
                   android:layout_height="match_parent"
                    />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/voucherExpireLL"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="false"
            android:visibility="gone"
            android:gravity="center">
            <include
                layout="@layout/dialog_subscription_expire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_10"
                android:layout_gravity="center" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>