<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".application_kotlin.presentation.activities.loo_discovery.WolooDashboard">






            <FrameLayout
                android:id="@+id/frm_home_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                >



                <fragment
                    android:id="@+id/map"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                   />

                <LinearLayout
                    android:id="@+id/enrout_search_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:orientation="horizontal"
                   >

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/current_location_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/_2sdp"
                            android:layout_weight="1"
                            android:background="@drawable/rectangle_shape"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_5sdp"
                                android:src="@drawable/enroute_start_icon" />

                            <in.woloo.www.application_kotlin.utilities.CenturiGhoticAutoComplete
                                android:id="@+id/search_auto_complete_current_location"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/transparent"
                                android:completionThreshold="2"
                                android:hint="@string/search_by_location"
                                android:padding="@dimen/margin_3" />


                        </LinearLayout>



                        <LinearLayout
                            android:id="@+id/search_auto_complete_destination_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:layout_weight="1"
                            android:background="@drawable/new_button_background"
                            android:orientation="horizontal"
                            android:clickable="true">

                            <ImageView
                                android:id="@+id/search_image"
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_5sdp"
                                android:src="@drawable/search_icon_home" />

                            <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                                android:id="@+id/search_auto_complete"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@color/transparent"
                                android:completionThreshold="2"
                                android:clickable="true"
                                android:maxLines="2"
                                android:hint="@string/search_by_location"
                                android:padding="@dimen/_5sdp"
                                android:textSize="@dimen/_11sdp"
                                android:layout_weight="1"
                                />

                            <ImageView
                                android:id="@+id/clear_image"
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_5sdp"
                                android:src="@drawable/ic_close" />


                        </LinearLayout>

                        <ImageView
                            android:id="@+id/current_transport_mode"
                            android:layout_width="@dimen/_25sdp"
                            android:layout_height="@dimen/_25sdp"
                            android:src="@drawable/car_navigation"
                            android:layout_marginVertical="@dimen/_10sdp"
                            />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/new_button_background_smallest"
                            android:backgroundTint="@color/white_75"
                            android:orientation="horizontal"
                            android:layout_marginVertical="@dimen/_10sdp"
                            android:id="@+id/transport_mode_layout"
                            android:visibility="gone"
                            >

                        <ImageView
                            android:id="@+id/byCarShow"
                            android:layout_width="@dimen/_25sdp"
                            android:layout_height="@dimen/_25sdp"
                            android:src="@drawable/car_navigation"
                            android:elevation="@dimen/_2sdp"
                            android:layout_margin="@dimen/_3sdp"
                            />

                        <ImageView
                            android:id="@+id/byBikeShow"
                            android:layout_width="@dimen/_25sdp"
                            android:layout_height="@dimen/_25sdp"
                            android:src="@drawable/bike_navigation"
                            android:elevation="@dimen/_2sdp"
                            android:layout_margin="@dimen/_3sdp"
                            />

                        <ImageView
                            android:id="@+id/byWalkShow"
                            android:layout_width="@dimen/_25sdp"
                            android:layout_height="@dimen/_25sdp"
                            android:src="@drawable/walk_navigation"
                            android:elevation="@dimen/_2sdp"
                            android:layout_margin="@dimen/_3sdp"
                            />
                        </LinearLayout>

                    </LinearLayout>
                  <LinearLayout
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:orientation="vertical">

                      <ImageView
                          android:id="@+id/show_extra_parameters"
                          android:layout_width="@dimen/_30sdp"
                          android:layout_height="@dimen/_30sdp"
                          android:layout_gravity="center"
                          android:layout_marginLeft="@dimen/_5sdp"
                          android:layout_marginRight="@dimen/_5sdp"
                          android:layout_marginTop="@dimen/_2sdp"
                          android:src="@drawable/back_icon_enroute"
                          android:visibility="gone"
                          android:rotation="270"/>

                    <LinearLayout
                        android:id="@+id/extra_parameters_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"

                        >

                        <ImageView
                            android:id="@+id/imgEnrouteClick"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/en_route_click"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:layout_marginRight="@dimen/_5sdp"
                            android:layout_marginTop="@dimen/_2sdp"
                            />
                        <ImageView
                            android:id="@+id/imgScanQR"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/qr_scannner_click"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:layout_marginRight="@dimen/_5sdp"
                            android:layout_marginTop="@dimen/_2sdp"
                            />

                        <ImageView
                            android:id="@+id/show_bookmark_list"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_gravity="right"
                            android:src="@drawable/bookmark_home_icon"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:layout_marginRight="@dimen/_5sdp"
                            android:layout_marginTop="@dimen/_2sdp"
                           />

                        <ImageView
                            android:id="@+id/contact_us"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:src="@drawable/sos_home_icon"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:layout_marginRight="@dimen/_5sdp"
                            android:layout_marginTop="@dimen/_2sdp"
                           />

                        <ImageView
                            android:id="@+id/current_location_button"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:src="@drawable/current_location_icon"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:layout_marginRight="@dimen/_5sdp"
                            android:layout_marginTop="@dimen/_2sdp"
                            />




                    </LinearLayout>


                  </LinearLayout>


                </LinearLayout>






            </FrameLayout>


    <FrameLayout
        android:id="@+id/frm_home_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
       android:layout_alignParentBottom="true">

        <fragment
            android:id="@+id/fragment_map"
            android:name="in.woloo.www.application_kotlin.presentation.fragments.loo_discovery.HomeCategoryFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_65sdp"/>


    </FrameLayout>




            <FrameLayout
                android:id="@+id/frm_dialog_sos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:visibility="gone">

                <include
                    layout="@layout/dialog_sos_category"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    />
            </FrameLayout>



        <LinearLayout
            android:id="@+id/voucherExpireLL"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="false"
            android:visibility="gone"
            android:gravity="center">
            <include
                android:id="@+id/subscription_expired"
                layout="@layout/dialog_subscription_expire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_10"
                android:layout_gravity="center" />
        </LinearLayout>

    <include
        android:id="@+id/search_option_layout"
        layout="@layout/search_options"
        android:visibility="gone"
        />

    <FrameLayout
        android:id="@+id/overlay_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/trans_black_65"
        android:visibility="gone"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30sdp"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <ImageView
                        android:layout_width="@dimen/_72sdp"
                        android:layout_height="@dimen/_72sdp"
                        android:layout_marginLeft="@dimen/_70sdp"
                        android:src="@drawable/arrow_one"
                        />

                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_70sdp"
                        android:text="Search for Woloo\nHost or the Location\nyou want to go"
                        style="@style/overlay_style"
                        android:layout_marginRight="@dimen/_25sdp"
                        />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/_72sdp"
                        android:layout_height="@dimen/_72sdp"
                        android:layout_gravity="right"
                        android:src="@drawable/arrow_two" />

                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:gravity="center"
                        android:layout_marginRight="@dimen/_15sdp"
                        style="@style/overlay_style"
                        android:text="Use the drop-\ndown to see\n more options "
                        />
                </LinearLayout>

            </RelativeLayout>

            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="Welcome to\nWoloo"
                android:gravity="center"
                style="@style/overlay_style_middle"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/_30sdp"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >


                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Go to the\nmain page"
                        style="@style/overlay_style"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_marginLeft="@dimen/_2sdp"/>


                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show Hygiene\nProducts "
                        style="@style/overlay_style"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_marginLeft="@dimen/_5sdp"/>

                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rate a\nToilet"
                        style="@style/overlay_style"
                        android:layout_gravity="bottom"
                        android:gravity="bottom"
                        android:layout_marginLeft="@dimen/_5sdp"/>

                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search for\n Woloos "
                        style="@style/overlay_style"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_marginLeft="@dimen/_15sdp"/>


                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check your\nProfile "
                        style="@style/overlay_style"
                        android:layout_marginLeft="@dimen/_15sdp"
                        android:layout_gravity="center"
                        android:gravity="center"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bottom_arrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_65sdp"
                        android:layout_height="@dimen/_65sdp"
                        android:src="@drawable/arrow_six"
                        />

                    <ImageView
                        android:layout_width="@dimen/_72sdp"
                        android:layout_height="@dimen/_72sdp"
                        android:src="@drawable/arrow_five" />


                    <ImageView
                        android:layout_width="@dimen/_54sdp"
                        android:layout_height="@dimen/_54sdp"
                        android:src="@drawable/arrow_seven"
                        android:layout_gravity="bottom"
                        />


                    <ImageView
                        android:layout_width="@dimen/_72sdp"
                        android:layout_height="@dimen/_72sdp"
                        android:src="@drawable/arrow_four"
                        />



                    <ImageView
                        android:layout_width="@dimen/_65sdp"
                        android:layout_height="@dimen/_65sdp"
                        android:src="@drawable/arrow_three" />


                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</RelativeLayout>