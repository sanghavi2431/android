<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/application_background">

    <include layout="@layout/title_bar"/>

   <androidx.core.widget.NestedScrollView
       android:layout_width="match_parent"
       android:layout_below="@+id/toolbar"
       android:paddingBottom="@dimen/margin_50"
       android:clipToPadding="false"
       android:layout_height="match_parent">

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="match_parent"
           android:orientation="vertical">


           <ImageView
               android:layout_width="@dimen/margin_40"
               android:layout_height="@dimen/margin_40"
               android:layout_gravity="center"
               android:src="@drawable/ic_invite_friend"/>


           <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:textStyle="normal"
               android:textSize="@dimen/size_8"
               android:layout_marginLeft="@dimen/margin_15"
               android:layout_marginRight="@dimen/margin_15"
               android:layout_marginTop="@dimen/margin_5"
               android:textColor="@color/white"
               android:gravity="center_horizontal"
               android:text="@string/message_text" />


           <TextView
               android:id="@+id/tvReferalMsg"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginLeft="@dimen/margin_15"
               android:layout_marginTop="@dimen/margin_5"
               android:layout_marginRight="@dimen/margin_15"
               android:gravity="center_horizontal"
               android:text=""
               android:textColor="@color/white"
               android:textSize="@dimen/size_8"
               android:textStyle="normal" />

           <TextView
               android:id="@+id/termsAndConditionTv"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:textStyle="normal"
               android:textSize="@dimen/size_5"
               android:layout_marginLeft="@dimen/margin_15"
               android:layout_marginRight="@dimen/margin_15"
               android:layout_marginTop="@dimen/margin_5"
               android:textColor="@color/white"
               android:gravity="center"
               android:layout_gravity="center"
               android:text="Terms &amp; Conditions" />


           <TextView
               android:id="@+id/tvRefferalCode"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:textStyle="bold"
               android:textSize="@dimen/size_10"
               android:textColor="@color/text_color_five"
               android:letterSpacing="0.2"
               android:lineSpacingExtra="21sp"
               android:gravity="center_horizontal"
               android:background="@drawable/dash_rectangle_shape"
               android:padding="@dimen/margin_5"
               android:layout_gravity="center"
               android:layout_marginTop="@dimen/margin_10"
               android:text="" />

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginLeft="@dimen/margin_15"
               android:layout_marginTop="@dimen/margin_10"
               android:layout_marginRight="@dimen/margin_15"
               android:orientation="horizontal">

               <!--<LinearLayout
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:visibility="gone"
                   android:orientation="vertical"
                   android:gravity="center">

                   <ImageView
                       android:id="@+id/ivFacebook"
                       android:layout_width="@dimen/margin_15"
                       android:layout_height="@dimen/margin_15"
                       android:src="@drawable/ic_fb"/>

               </LinearLayout>

               <LinearLayout
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:orientation="vertical"
                   android:visibility="invisible"
                   android:gravity="center">

                   <ImageView
                       android:id="@+id/ivWhatsApp"
                       android:layout_width="@dimen/margin_15"
                       android:layout_height="@dimen/margin_15"
                       android:src="@drawable/ic_wht_app"/>

               </LinearLayout>-->

               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:gravity="center"
                   android:orientation="horizontal">

                  <ImageView
                   android:id="@+id/ivWhatsApp"
                   android:layout_width="@dimen/margin_15"
                   android:layout_height="@dimen/margin_15"
                   android:src="@drawable/ic_wht_app"
                      android:layout_marginHorizontal="@dimen/margin_5"
                      app:tint="@color/text_color_five" />
                   <ImageView
                       android:id="@+id/ivShare"
                       android:layout_width="@dimen/margin_15"
                       android:layout_height="@dimen/margin_15"
                       android:src="@drawable/ic_share_active"
                       android:layout_marginHorizontal="@dimen/margin_5"
                       app:tint="@color/text_color_five" />

               </LinearLayout>

           </LinearLayout>

           <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:textStyle="normal"
               android:textSize="@dimen/size_5"
               android:layout_marginLeft="@dimen/margin_15"
               android:layout_marginRight="@dimen/margin_15"
               android:layout_marginTop="@dimen/margin_10"
               android:textColor="@color/white"
               android:gravity="center"
               android:layout_gravity="center"
               android:text="@string/or" />

           <TextView
               android:id="@+id/tv_contacts"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:textSize="@dimen/size_7"
               android:textColor="@color/black"
               android:gravity="center_horizontal"
               android:background="@drawable/yellow_rectangle_shape"
               android:padding="@dimen/margin_5"
               android:layout_gravity="center"
               android:layout_marginTop="@dimen/margin_10"
               android:text="Invite Contacts" />

       </LinearLayout>
   </androidx.core.widget.NestedScrollView>


</RelativeLayout>