<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <ImageView
                    android:layout_width="@dimen/_200sdp"
                    android:layout_height="@dimen/_109sdp"
                   android:layout_gravity="center"
                    android:layout_marginVertical="@dimen/_15sdp"
                    android:src="@drawable/becom_icon"
                   />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                   >


                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        style="@style/button_text_style"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Dear Woloo Host," />

                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        style="@style/button_text_style"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/become_a_woloo_host_msg0_new" />
                </LinearLayout>



                <LinearLayout
                    android:id="@+id/llInterestedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/_15sdp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:id="@+id/btnInterest"
                        style="@style/button_text_style"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/yello_rectangle_shape"
                        android:elevation="@dimen/_5sdp"
                        android:gravity="center_horizontal"
                        android:text="@string/yes_i_am_interested" />

                </LinearLayout>


            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>