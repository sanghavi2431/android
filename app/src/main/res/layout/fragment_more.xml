<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".application_kotlin.presentation.MoreFragment">



            <RelativeLayout
                android:id="@+id/header_view_img"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bottom_rounded_corners"
                android:backgroundTint="@color/start_theme_color"
                android:elevation="@dimen/_5sdp"
                app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="@dimen/_62sdp"
                android:layout_height="@dimen/_44sdp"
                android:src="@drawable/woloo_powder_room_logo"
                android:layout_centerInParent="true"
                android:layout_margin="@dimen/_9sdp"/>

            </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/header_view_img"
        app:layout_constraintBottom_toBottomOf="parent"
       >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <androidx.cardview.widget.CardView
                android:id="@+id/first_card_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/search_background"
                app:cardCornerRadius="@dimen/_24sdp"
                android:elevation="@dimen/_4sdp"
                android:layout_marginVertical="@dimen/_15sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_alignParentTop="true">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                <LinearLayout
                    android:id="@+id/layout_card_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
                    android:layout_alignParentTop="true">
    <in.woloo.www.utils.CircleImageView
        android:id="@+id/civProfileImage"
        android:layout_width="@dimen/_62sdp"
        android:layout_height="@dimen/_62sdp"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_5sdp"

       />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:orientation="vertical">
        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvName"
            style="@style/bottom_woloo_host_header_style"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/chip_color"
            android:layout_marginRight="@dimen/_10sdp"
          />
        <RelativeLayout
            android:id="@+id/credit_history_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/tvWolooPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Woloo Points"
            style="@style/points_text_header_style"
            />

            <ImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:layout_centerInParent="true"
                android:layout_toRightOf="@+id/tvWolooPoints"
                android:src="@drawable/onclick_icon_profile"
                />


        </RelativeLayout>




    </LinearLayout>
    <ImageView
        android:id="@+id/iv_edit"
        android:layout_width="@dimen/_15sdp"
        android:layout_height="@dimen/_15sdp"
        android:src="@drawable/pencil_icon_profile"
        android:layout_margin="@dimen/_10sdp"
       />

</LinearLayout>
                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:id="@+id/tvWolooPremium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    style="@style/twelve_black_nomargin_center"
                    android:elevation="@dimen/_4sdp"
                    android:layout_marginLeft="@dimen/_15sdp"
                    android:layout_marginRight="@dimen/_15sdp"
                    android:padding="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_15sdp"
                    android:layout_below="@+id/layout_card_top"
                    />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:layout_marginLeft="@dimen/_15sdp"
                        android:layout_marginRight="@dimen/_15sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp">
                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/tvMobileNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/image_woloo_host_bg"
                            style="@style/small_button_style"
                            android:layout_marginRight="@dimen/_4sdp"
                            android:visibility="gone"
                            />
                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/tvCity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/city"
                            android:layout_weight="1"
                            android:singleLine="true"
                            android:background="@drawable/image_woloo_host_bg"
                            style="@style/small_button_style"
                            android:layout_marginRight="@dimen/_2sdp"
                            android:visibility="gone"
                            android:layout_marginLeft="@dimen/_2sdp"/>
                        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                            android:id="@+id/tvGender"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/image_woloo_host_bg"
                            style="@style/small_button_style"
                            android:visibility="gone"
                            android:layout_marginLeft="@dimen/_2sdp"/>

                    </RelativeLayout>

                </RelativeLayout>

            </androidx.cardview.widget.CardView>
            <View
                android:id="@+id/line_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginRight="@dimen/_15sdp"
                android:background="@color/start_theme_color"
                android:layout_below="@id/first_card_view"/>

            <RelativeLayout
                android:id="@+id/bottom_linear"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_80sdp"
                android:layout_below="@+id/line_view">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMenus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    tools:itemCount="1"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    tools:listitem="@layout/recycler_gridlayout_design"
                    android:layout_alignParentTop="true"/>

                <RelativeLayout
                    android:layout_below="@+id/rvMenus"
                    android:id="@+id/logout_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/yello_rectangle_shape"
                    android:layout_gravity="center"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:gravity="center"
                    android:elevation="@dimen/_4sdp"
                    android:layout_marginVertical="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp">
                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/logout_icon"
                    android:layout_margin="@dimen/_5sdp"
                    android:layout_toLeftOf="@+id/tv_logout"
                    android:layout_centerVertical="true"
                    />
                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:id="@+id/tv_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/size_7"
                    android:textColor="@color/black"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/_5sdp"
                    android:layout_gravity="center"
                    android:elevation="@dimen/_4sdp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:text="Logout"
                   />
                </RelativeLayout>
            </RelativeLayout>



            <RelativeLayout
                android:id="@+id/ll_wolooPremium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvWolooPremiumTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:text="@string/woloo_premium"
                    android:textColor="#6a6a6a"
                    android:textSize="@dimen/size_6"
                    android:textStyle="bold" />

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="2"
                    android:textAllCaps="true"
                    android:textColor="#000000"
                    android:textSize="@dimen/size_6"
                    android:textStyle="bold"
                    tools:text="Long long text so long text so so long" />

            </RelativeLayout>

        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>




</androidx.constraintlayout.widget.ConstraintLayout>