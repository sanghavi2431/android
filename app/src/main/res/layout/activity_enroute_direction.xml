<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/application_background"
        android:padding="@dimen/margin_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/margin_7"
            android:layout_height="@dimen/margin_7"
            android:layout_centerVertical="true"
            android:alpha="1"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="@+id/imageView5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/imageView5"
            app:tint="@color/white" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/etSourceLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_5"
            android:background="@drawable/rounded_corner_gray_outlined"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imageView5"
            app:layout_constraintTop_toTopOf="parent">

            <AutoCompleteTextView
                android:id="@+id/etSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                android:completionThreshold="2"
                android:hint="@string/label_source"
                android:inputType="text"
                android:lineSpacingExtra="6.7sp"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/margin_5"
                android:paddingVertical="@dimen/margin_2"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/white"
                android:textColorHint="@color/text_color_four"
                android:textSize="@dimen/size_7"
                android:textStyle="normal"
                android:layout_weight="9"/>


            <ImageView
                android:id="@+id/iv_cancel_source"
                android:layout_width="@dimen/size_10"
                android:layout_height="@dimen/size_10"
                android:layout_marginHorizontal="@dimen/margin_3"
                android:layout_weight="1"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />
        </androidx.appcompat.widget.LinearLayoutCompat>


        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="@dimen/size_11"
            android:layout_height="@dimen/size_11"
            android:layout_marginLeft="@dimen/margin_4"
            android:src="@drawable/source_icon"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintBottom_toBottomOf="@+id/etSourceLayout"
            app:layout_constraintTop_toTopOf="@+id/etSourceLayout" />

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="@dimen/size_12"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/margin_4"
            android:src="@drawable/dots_vertical"
            app:layout_constraintBottom_toTopOf="@+id/imageView"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toBottomOf="@+id/imageView5"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="@dimen/size_11"
            android:layout_height="@dimen/size_11"
            android:layout_marginLeft="@dimen/margin_4"
            android:src="@drawable/dest_map_icon"
            app:layout_constraintBottom_toBottomOf="@+id/etDestLayout"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="@+id/etDestLayout"/>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/etDestLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/margin_5"
            android:background="@drawable/rounded_corner_gray_outlined"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="10"
            app:layout_constraintEnd_toEndOf="@+id/etSourceLayout"
            app:layout_constraintStart_toStartOf="@+id/etSourceLayout"
            app:layout_constraintTop_toBottomOf="@+id/etSourceLayout">

            <AutoCompleteTextView
                android:id="@+id/etDest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="9"
                android:background="@color/transparent"
                android:completionThreshold="2"
                android:hint="@string/label_dest"
                android:inputType="text"
                android:lineSpacingExtra="6.7sp"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/margin_5"
                android:paddingVertical="@dimen/margin_2"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/white"
                android:textColorHint="@color/text_color_four"
                android:textSize="@dimen/size_7"
                android:textStyle="normal" />


            <ImageView
                android:id="@+id/iv_cancel_dest"
                android:layout_width="@dimen/size_10"
                android:layout_height="@dimen/size_10"
                android:layout_marginHorizontal="@dimen/margin_3"
                android:layout_weight="1"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />
        </androidx.appcompat.widget.LinearLayoutCompat>



        <LinearLayout
            android:id="@+id/ll_top_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etDestLayout">

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_topbar"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/margin_6"
                android:textColor="@color/white"
                android:textSize="@dimen/size_10"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/app_background"
                android:textSize="@dimen/size_8"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:padding="@dimen/margin_3"
                android:text="Please enter source and destination"
                android:textColor="@color/white"
                android:textSize="@dimen/size_6"
                android:textStyle="bold" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/application_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout">

        <FrameLayout
            android:id="@+id/frm_home_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <fragment
                android:id="@+id/map"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                />



        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/frm_home_data"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/ll_nav_view2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@color/transparent_black_90"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_woloo_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:paddingTop="@dimen/margin_2"
                    android:paddingBottom="@dimen/margin_2"
                    android:drawableTop="@drawable/rounded_yellow_bg"
                    android:text="Woloo-Hosts On-Route"
                    android:textColor="@color/app_background"
                    android:textSize="@dimen/size_6"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/ll_nav_view2"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="@dimen/margin_2">
                <fragment
                    android:id="@+id/fragment_map"
                    android:name="in.woloo.www.home.fragments.HomeCategoryFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    />
            </FrameLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/frm_marker_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/ll_nav_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/transparent_black_90"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_woloo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingVertical="@dimen/margin_2"
            android:drawableTop="@drawable/rounded_yellow_bg"
            android:text="Woloo-Hosts On-Route"
            android:textColor="@color/app_background"
            android:textSize="@dimen/size_6"
            android:textStyle="bold" />
    </LinearLayout>


    <FrameLayout
        android:id="@+id/ll_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/toprounded_corner_theme">

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="@dimen/size_12"
                android:layout_height="@dimen/size_12"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/size_12"
                android:layout_marginTop="@dimen/size_12"
                android:layout_marginEnd="@dimen/size_12"
                android:layout_marginBottom="@dimen/size_12"
                app:srcCompat="@drawable/ic_closed" />

            <RelativeLayout
                android:id="@+id/rl_center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/size_6"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_topbar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/rounded_yellow_bg"/>


                <TextView
                    android:id="@+id/tv_time_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/iv_topbar"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/margin_2"
                    android:layout_marginRight="@dimen/margin_6"
                    android:layout_marginBottom="@dimen/margin_2"
                    android:textColor="@color/white"
                    android:textSize="@dimen/size_10"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_distance_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/iv_topbar"
                    android:layout_alignBaseline="@+id/tv_time_bottom"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/margin_2"
                    android:layout_marginBottom="@dimen/margin_2"
                    android:layout_toRightOf="@+id/tv_time_bottom"
                    android:textColor="@color/app_background"
                    android:textSize="@dimen/size_6"
                    android:textStyle="bold" />


            </RelativeLayout>


            <ImageView
                android:id="@+id/iv_currentlocation"
                android:layout_width="@dimen/size_12"
                android:layout_height="@dimen/size_12"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_margin="@dimen/size_12"
                app:srcCompat="@drawable/ic_direction" />

            <TextView
                android:id="@+id/tv_start"
                android:layout_width="@dimen/margin_30"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_center"
                android:layout_centerHorizontal="true"
                android:layout_marginRight="@dimen/margin_3"
                android:layout_marginBottom="@dimen/margin_2"
                android:background="@drawable/yello_rectangle_shape"
                android:drawableLeft="@drawable/arrow_yellow"
                android:drawablePadding="@dimen/margin_1"
                android:gravity="center"
                android:padding="@dimen/margin_3"
                android:paddingLeft="@dimen/margin_2"
                android:paddingRight="@dimen/margin_2"
                android:singleLine="true"
                android:text="Start"
                android:textColor="@color/text_color_one"
                android:textSize="@dimen/size_6"
                android:textStyle="bold"
                android:visibility="gone"/>


            <TextView
                android:id="@+id/tv_info_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_center"
                android:layout_marginRight="@dimen/margin_3"
                android:layout_marginBottom="@dimen/margin_2"
                android:layout_toStartOf="@+id/iv_currentlocation"
                android:layout_toEndOf="@+id/iv_close"
                android:drawablePadding="@dimen/margin_1"
                android:gravity="center"
                android:padding="@dimen/margin_3"
                android:paddingLeft="@dimen/margin_2"
                android:paddingRight="@dimen/margin_2"
                android:text="Please enter source and destination"
                android:textColor="@color/white"
                android:textSize="@dimen/size_6"
                android:textStyle="bold" />

        </RelativeLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>