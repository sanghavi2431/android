<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/full_screen_layout">





    <FrameLayout
            android:id="@+id/frm_home_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
          >



            <fragment
                android:id="@+id/map"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                />

            <LinearLayout
                android:id="@+id/enrout_search_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <ImageView
                    android:id="@+id/back_from_enroute"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:src="@drawable/back_icon_enroute"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_5sdp"/>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/current_transport_mode"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginRight="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:src="@drawable/car_navigation"
                        />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/new_button_background_smallest"
                        android:backgroundTint="@color/white_75"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:id="@+id/transport_mode_layout"
                        android:visibility="gone"
                        >

                        <ImageView
                            android:id="@+id/byCarShow"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_margin="@dimen/_3sdp"
                            android:src="@drawable/car_navigation"
                            android:elevation="@dimen/_2sdp"
                            />

                        <ImageView
                            android:id="@+id/byBikeShow"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:src="@drawable/bike_navigation"
                            android:elevation="@dimen/_2sdp"
                            android:layout_margin="@dimen/_3sdp"
                            />

                        <ImageView
                            android:id="@+id/byWalkShow"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:src="@drawable/walk_navigation"
                            android:elevation="@dimen/_2sdp"
                            android:layout_margin="@dimen/_3sdp"
                            />
                    </LinearLayout>

                </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">



                    <LinearLayout
                        android:id="@+id/current_location_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5sdp"
                        android:elevation="@dimen/_4sdp"
                        android:background="@drawable/new_button_background"
                        android:orientation="horizontal"
                        >

                        <ImageView
                            android:id="@+id/imageView5"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_gravity="center"
                            android:layout_margin="@dimen/_5sdp"
                            android:src="@drawable/pin_current_location_icon" />

                        <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                            android:id="@+id/etSource"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/transparent"
                            android:completionThreshold="2"
                            android:hint="Search Source Host"
                            android:padding="@dimen/margin_3"
                            android:singleLine="true"/>


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/destination_location_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:layout_weight="1"
                        android:elevation="@dimen/_4sdp"
                        android:background="@drawable/new_button_background"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageView"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_gravity="center"
                            android:layout_margin="@dimen/_5sdp"
                            android:src="@drawable/pin_destination_icon" />

                        <in.woloo.www.application_kotlin.utilities.CenturyGothicRegularTextView
                            android:id="@+id/etDest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/transparent"
                            android:completionThreshold="2"
                            android:singleLine="true"
                            android:hint="Search Destination Host"
                            android:padding="@dimen/margin_3" />


                    </LinearLayout>


                </LinearLayout>




</LinearLayout>

            </LinearLayout>






        </FrameLayout>




    <FrameLayout
        android:id="@+id/frm_home_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toTopOf="@+id/navigate_layout_time_distance"
        >




        <fragment
            android:id="@+id/fragment_map"
            android:name="in.woloo.www.application_kotlin.presentation.fragments.loo_discovery.HomeCategoryFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            />
    </FrameLayout>




    <LinearLayout
        android:id="@+id/navigate_layout_time_distance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/_30sdp"
        android:layout_marginVertical="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="@+id/frm_home_map">

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/tvStartNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Navigation"
            android:background="@drawable/yello_rectangle_shape"
            style="@style/screen_sub_header_text_center"
            android:layout_marginBottom="@dimen/_10sdp"
            android:padding="@dimen/_10sdp"

            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/yello_rectangle_shape">

        <View
            android:layout_width="@dimen/_1sdp"
            android:layout_height="match_parent"
            android:background="@color/chip_color"
            android:visibility="gone"
            />
        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/tvRequiredTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Time"
            android:maxLines="1"
            android:layout_weight="1"
            android:gravity="right"
            style="@style/screen_sub_header_text_no_gravity"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"/>

        <View
            android:layout_width="@dimen/_1sdp"
            android:layout_height="match_parent"
            android:background="@color/chip_color"/>

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/tvDistance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Distance"
            android:maxLines="1"
            android:layout_weight="1"
            android:gravity="left"
            style="@style/screen_sub_header_text_no_gravity"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"/>
        </LinearLayout>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>