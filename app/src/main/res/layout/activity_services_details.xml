<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
xmlns:cardview="http://schemas.android.com/apk/res-auto"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
tools:context=".services.screens.ServicesDetailsActivity">

<LinearLayout
    android:id="@+id/ivBack"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="@dimen/_12sdp"
    android:layout_marginHorizontal="@dimen/_10sdp"
    android:gravity="center"
    android:layout_alignParentTop="true"
    >

    <ImageView

        android:layout_width="@dimen/_10sdp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/_7sdp"
        android:adjustViewBounds="true"
        android:rotation="90"
        android:layout_gravity="center"
        android:src="@drawable/down_arrow_bottom_bar"
        />
    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/small_gray_style"
        android:text="@string/back"
        android:gravity="center"
        />

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginBottom="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">



        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:itemCount="1"
            android:id="@+id/product_image_recycler"
            tools:listitem="@layout/services_image_recycler"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="@dimen/_10sdp">
            <ImageView
                android:id="@+id/ivVeryBad"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:src="@drawable/filled_star_new"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_gravity="center"
                />
            <ImageView
                android:id="@+id/ivBad"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:src="@drawable/filled_star_new"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_gravity="center"
                />
            <ImageView
                android:id="@+id/ivAverage"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:src="@drawable/filled_star_new"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_gravity="center"
                />
            <ImageView
                android:id="@+id/ivGood"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:src="@drawable/filled_star_new"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_gravity="center"
                />
            <ImageView
                android:id="@+id/ivLovedIt"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:src="@drawable/filled_star_new"
                android:layout_marginRight="@dimen/_5sdp"
                android:layout_gravity="center"
                />
            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:id="@+id/review_count_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(5)"
                style="@style/refer_3_host_style"
                android:layout_gravity="center"
                />
            <ImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="match_parent"
                android:src="@drawable/down_navigate_arrow"
                android:rotation="270"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/_2sdp"
                android:visibility="gone"

                />
            <RelativeLayout
                android:id="@+id/add_cart_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/yello_rectangle_shape"
                android:paddingHorizontal="@dimen/_5sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/_5sdp"

                >


                <ImageView
                    android:id="@+id/cart_icon"
                    android:layout_width="@dimen/_13sdp"
                    android:layout_height="@dimen/_13sdp"
                    android:src="@drawable/cart_icon"
                    android:layout_centerVertical="true"
                    />
                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add To Cart"
                    android:layout_toRightOf="@+id/cart_icon"
                    style="@style/screen_sub_header_text_left"
                    android:layout_centerVertical="true"
                    android:maxLines="1"
                    />

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/yello_rectangle_shape"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:id="@+id/quantity_layout"
                android:visibility="gone"
                >

                <ImageView
                    android:id="@+id/remove_cart_item_image"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/remove_cart_item"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    >

                    <ImageView
                        android:id="@+id/cart_icon_image"
                        android:layout_width="@dimen/_13sdp"
                        android:layout_height="@dimen/_13sdp"
                        android:src="@drawable/cart_icon"
                        android:layout_centerVertical="true"
                        />
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:id="@+id/cart_count_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_toRightOf="@+id/cart_icon_image"
                        style="@style/refer_3_host_style"
                        android:layout_centerVertical="true"

                        />
                </RelativeLayout>


                <ImageView
                    android:id="@+id/add_cart_item_image"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/add_cart_item"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    />

            </RelativeLayout>
        </LinearLayout>

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/product_details_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feather Toilet Seat"
            style="@style/twenty_black_left"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginVertical="@dimen/_5sdp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="@dimen/_5sdp">

            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹799"
                style="@style/big_price_text_black"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_5sdp"
                android:id="@+id/product_price"
                />
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/product_price"
                android:layout_toLeftOf="@+id/buy_now_button"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_1sdp">

                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:id="@+id/woloo_coins"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="After using woloo points \nDiscounted Price"
                    style="@style/calendar_text_style_center"
                    android:layout_alignParentTop="true"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_1sdp"/>

                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:id="@+id/product_details_discount_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹500"
                    style="@style/policy_text_style_center"
                    android:layout_below="@+id/woloo_coins"
                    android:maxLines="1"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_5sdp"/>
                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:id="@+id/woloo_discount_apply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Coins"
                    style="@style/calendar_text_style_center"
                    android:layout_below="@+id/woloo_coins"
                    android:background="@drawable/new_button_background_smallest"
                    android:backgroundTint="@color/start_theme_color"
                    android:paddingVertical="@dimen/_2sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:elevation="@dimen/_1sdp"
                    android:layout_margin="@dimen/_2sdp"
                    android:maxLines="1"
                    android:layout_alignParentRight="true"/>

            </RelativeLayout>

            <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buy Now"
                style="@style/twelve_black_nomargin_center"
                android:layout_centerVertical="true"
                android:paddingVertical="@dimen/_7sdp"
                android:paddingHorizontal="@dimen/_20sdp"
                android:layout_gravity="center"
                android:elevation="@dimen/_4sdp"
                android:layout_margin="@dimen/_5sdp"
                android:background="@drawable/yello_rectangle_shape"
                android:id="@+id/buy_now_button"
                android:layout_alignParentRight="true"
                />


        </RelativeLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/bg_gray"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginVertical="@dimen/_4sdp"/>

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About the Services"
            style="@style/pop_up_left"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginVertical="@dimen/_5sdp"/>





    </LinearLayout>

</androidx.core.widget.NestedScrollView>

<RelativeLayout
    android:id="@+id/button_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_10sdp"
    android:background="@drawable/top_corener_image_bg"
    android:layout_alignParentBottom="true"
    android:elevation="@dimen/_4sdp"
    android:layout_marginTop="@dimen/_5sdp"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/buy_now_direct_payment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/yello_rectangle_shape"
            android:text="Buy Now"
            android:layout_marginRight="@dimen/_10sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            style="@style/screen_header_text_style_big_center_nomargin"
            android:paddingVertical="@dimen/_10sdp"

            />

        <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
            android:id="@+id/add_to_cart_dialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/yello_rectangle_shape"
            android:backgroundTint="@color/check_button_color"
            android:text="Add to Cart"
            android:layout_marginLeft="@dimen/_10sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            style="@style/screen_header_text_style_big_center_nomargin"
            android:paddingVertical="@dimen/_10sdp"

            />

    </LinearLayout>


</RelativeLayout>


</LinearLayout>