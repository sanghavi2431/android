<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:cardview="http://schemas.android.com/tools"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardViewParent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/white"
    cardview:cardCornerRadius="@dimen/_19sdp"
    cardview:cardElevation="@dimen/_4sdp"
    android:layout_marginTop="@dimen/_10sdp"
    android:layout_marginBottom="@dimen/_10sdp"
    android:layout_marginHorizontal="@dimen/_10sdp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/bottom_host_image"
                android:layout_width="@dimen/_57sdp"
                android:layout_height="@dimen/_57sdp"
                android:background="@drawable/image_woloo_bg_small"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:src="@drawable/feather_img"
                android:layout_margin="@dimen/_8sdp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginVertical="@dimen/_8sdp">
                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Feather Toilet Seat"
                    style="@style/refer_3_host_style"
                    android:maxLines="1"
                    android:id="@+id/product_name"
                    android:layout_marginLeft="@dimen/_5sdp"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/line_color"
                    android:layout_marginRight="@dimen/_35sdp"
                    android:layout_marginLeft="@dimen/_5sdp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Size : M"
                        android:maxLines="1"
                        android:id="@+id/variant_details"
                        style="@style/policy_text_style_left"
                        android:layout_marginLeft="@dimen/_5sdp"/>
                    <View
                        android:layout_width="@dimen/_1sdp"
                        android:layout_height="match_parent"
                        android:background="@color/line_host_details"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:layout_marginVertical="@dimen/_2sdp"/>
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Qty : "
                        android:maxLines="1"
                        style="@style/policy_text_style_left"
                        android:id="@+id/product_quantity"
                        />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="₹ 799"
                        style="@style/pop_up_left"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:gravity="bottom"
                        android:id="@+id/product_price"
                        android:maxLines="1"
                        android:layout_gravity="bottom"/>
                    <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="MRP &#8377;9,999"
                        style="@style/mrp_eleven"
                        android:maxLines="1"
                        android:gravity="left|bottom"
                        android:layout_toRightOf="@id/product_price"
                        android:id="@+id/product_price_original"/>
                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/service_date_time_cart_list_item"
            tools:itemCount="2"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_15sdp"
            android:id="@+id/service_date_time_recycler"
            />

    </LinearLayout>
</androidx.cardview.widget.CardView>