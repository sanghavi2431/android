<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:cardview="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewParent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/line_color"
        android:layout_marginVertical="@dimen/_3sdp"
        android:layout_marginHorizontal="@dimen/_25sdp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >


                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Service Date and Time"
                    style="@style/policy_text_style_left"
                    android:maxLines="1"
                    android:layout_weight="1.8"
                    android:gravity="center_vertical" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:orientation="vertical">
                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="05-JUL-2025"
                    android:id="@+id/service_date_allocated"
                    style="@style/refer_3_host_style"/>

                <in.woloo.www.application_kotlin.utilities.CenturyGoticBoldTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="03.00 PM"
                    android:id="@+id/service_time_allocated"
                    style="@style/refer_3_host_style"/>
            </LinearLayout>


            <ImageView
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_gravity="center"
                android:src="@drawable/edit_address"
                cardview:tint="@color/line_host_details"
                android:id="@+id/edit_date_time"/>
    </LinearLayout>




</LinearLayout>