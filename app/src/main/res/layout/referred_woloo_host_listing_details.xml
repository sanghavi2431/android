<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_10"
    android:background="@color/transparent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/host_imv"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_80"
                android:background="@drawable/half_circle_shape_background"
                android:src="@drawable/woloo_host_listing_data_image"/>

            <TextView
                android:id="@+id/status_Tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Under Review"
                android:gravity="center"
                android:textColor="@color/text_color_seven"
                android:paddingLeft="@dimen/margin_5"
                android:paddingRight="@dimen/margin_5"
                android:layout_gravity="right|top"
                android:background="@drawable/top_half_bottom_half_shap_background"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="@dimen/margin_3"
                android:layout_gravity="bottom|left">

                <TextView
                    android:id="@+id/host_title_Tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/margin_8"
                    android:layout_marginLeft="@dimen/margin_2"
                    android:textStyle="bold"
                    android:textColor="@color/text_color_eight"
                    android:text="Woloo Powder Room"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_2"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/margin_8"
                        android:layout_height="@dimen/margin_8"
                        android:src="@drawable/ic_location__icon"/>

                    <TextView
                        android:id="@+id/host_address_Tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12dp"
                        android:textColor="@color/text_color_eight"
                        android:text="Fortaleza Complex, East Ave, Kalyani Nagar"/>

                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</LinearLayout>